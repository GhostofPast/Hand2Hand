CompilerIf #H2H_MODE=#H2H_MODE_SAVE
Procedure.i PlayerExportJSON(*parent=0)
	If Not *parent
		*parent=CreateJSONObject()
	EndIf
	addJSONInteger(*parent,"PLAYER_HP_BASE",PLAYER_HP_BASE)
	addJSONInteger(*parent,"PLAYER_HP_BONUS",PLAYER_HP_BONUS)
	
	addJSONInteger(*parent,"PLAYER_STUN_MAX",PLAYER_STUN_MAX)

	addJSONInteger(*parent,"PLAYER_DODGE_BASE",PLAYER_DODGE_BASE)
	addJSONInteger(*parent,"PLAYER_DODGE_MARGIN",PLAYER_DODGE_MARGIN)
	addJSONInteger(*parent,"PLAYER_DODGE_PER_AGILITY",PLAYER_DODGE_PER_AGILITY)
	addJSONInteger(*parent,"PLAYER_DODGE_RELOAD_PER_AGILITY",PLAYER_DODGE_RELOAD_PER_AGILITY)
	
	addJSONDouble(*parent,"PLAYER_GUARD_BASE",PLAYER_GUARD_BASE)
	addJSONDouble(*parent,"PLAYER_GUARD_PER_WEIGHT",PLAYER_GUARD_PER_WEIGHT)
	addJSONDouble(*parent,"PLAYER_GUARD_PER_SECOND",PLAYER_GUARD_PER_SECOND)
	addJSONDouble(*parent,"PLAYER_GUARD_PER_SECOND_PER_ENDURANCE",PLAYER_GUARD_PER_SECOND_PER_ENDURANCE)

	addJSONInteger(*parent,"PLAYER_REGEN_THRESHOLD",PLAYER_REGEN_THRESHOLD)
	addJSONInteger(*parent,"PLAYER_REGEN_TOTAL_BASE",PLAYER_REGEN_TOTAL_BASE)
	addJSONInteger(*parent,"PLAYER_REGEN_TOTAL_INCREMENT",PLAYER_REGEN_TOTAL_INCREMENT)

	addJSONInteger(*parent,"PLAYER_REGEN_TICK_BASE",PLAYER_REGEN_TICK_BASE)
	addJSONInteger(*parent,"PLAYER_REGEN_TICK_DECREMENT",PLAYER_REGEN_TICK_DECREMENT)
	
	addJSONDouble(*parent,"PLAYER_RECOVERY_AGILITY_FACTOR",PLAYER_RECOVERY_AGILITY_FACTOR)
	addJSONDouble(*parent,"PLAYER_RECOVERY_AGILITY_SHORTCUT",PLAYER_RECOVERY_AGILITY_SHORTCUT)
	addJSONDouble(*parent,"PLAYER_RECOVERY_PARTIAL_FACTOR",PLAYER_RECOVERY_PARTIAL_FACTOR)
	
	addJSONInteger(*parent,"PLAYER_WEIGHT_LAND_THRESHOLD",PLAYER_WEIGHT_LAND_THRESHOLD)

	addJSONDouble(*parent,"PLAYER_DAMAGE_CUT_PER_CUT",PLAYER_DAMAGE_CUT_PER_CUT)
	addJSONDouble(*parent,"PLAYER_DAMAGE_CUT_PER_STRENGTH",PLAYER_DAMAGE_CUT_PER_STRENGTH)
	addJSONDouble(*parent,"PLAYER_DAMAGE_CUT_PER_AGILITY",PLAYER_DAMAGE_CUT_PER_AGILITY)
	addJSONDouble(*parent,"PLAYER_DAMAGE_CUT_PER_SPEED",PLAYER_DAMAGE_CUT_PER_SPEED)
	addJSONDouble(*parent,"PLAYER_DAMAGE_CUT_PER_WEIGHT",PLAYER_DAMAGE_CUT_PER_WEIGHT)

	addJSONDouble(*parent,"PLAYER_DAMAGE_PIERCE_PER_PIERCE",PLAYER_DAMAGE_PIERCE_PER_PIERCE)
	addJSONDouble(*parent,"PLAYER_DAMAGE_PIERCE_PER_STRENGTH",PLAYER_DAMAGE_PIERCE_PER_STRENGTH)
	addJSONDouble(*parent,"PLAYER_DAMAGE_PIERCE_PER_AGILITY",PLAYER_DAMAGE_PIERCE_PER_AGILITY)
	addJSONDouble(*parent,"PLAYER_DAMAGE_PIERCE_PER_SPEED",PLAYER_DAMAGE_PIERCE_PER_SPEED)
	addJSONDouble(*parent,"PLAYER_DAMAGE_PIERCE_PER_WEIGHT",PLAYER_DAMAGE_PIERCE_PER_WEIGHT)

