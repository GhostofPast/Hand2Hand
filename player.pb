Macro playerGetJumpPower(p)
	jumpPower(playerGetStrength(p),playerGetSpeed(p),playerGetWeight(p))
EndMacro

Procedure playerLandEffectSpawn(*p.player,white.i=#False)
	If windEnabled=#H2H_FRAME_WIND_MODE_DISABLED Or windEnabled=#H2H_FRAME_WIND_MODE_ONLY_ACTIVE
		ProcedureReturn
	EndIf
	*g.animationgadget
	*g2.animationgadget
	If playerGetWeight(*p)>3
		*g=gadgetSpawnEffect(*landHeavyFront(Random(ArraySize(*landHeavyFront()))),*p\position,#H2H_GADGET_LAYER_FRONT,*p\lockedDirection)
		*g2=gadgetSpawnEffect(*landHeavyBack(Random(ArraySize(*landHeavyBack()))),*p\position,#H2H_GADGET_LAYER_BACK,*p\lockedDirection)
	Else
		*g=gadgetSpawnEffect(*landLightFront(Random(ArraySize(*landLightFront()))),*p\position,#H2H_GADGET_LAYER_FRONT,*p\lockedDirection)
		*g2=gadgetSpawnEffect(*landLightBack(Random(ArraySize(*landLightBack()))),*p\position,#H2H_GADGET_LAYER_BACK,*p\lockedDirection)
	EndIf
	*g\color=playerGetColor(*p)
	*g\colorIntensity=playerGetColorIntensity(*p)/1.5
	If Not white
		*g\colorIntensity/1.5
	EndIf
	If windEnabled=#H2H_FRAME_WIND_MODE_HALVED Or windEnabled=#H2H_FRAME_WIND_MODE_HALVED_NONACTIVE
		*g\opacity=128
		*g2\opacity=128
		*g\colorIntensity/2
	EndIf
	*g2\color=*g\color
	*g2\colorIntensity=*g\colorIntensity
EndProcedure

Procedure playerLand(*p.player,*b.background)
	If Abs(*p\deltaMovement\y)<20
		playerResetAnimationTo(*p,playerGetIdle(*p))
;  		Debug "land 1"
	Else		
		playerJumpReload(*p)
		playerLandEffectSpawn(*p,*b\white)
		playerShakeGround(*p)
		
		If Not demoFight
			If playerGetWeight(*p)>3
				psound(#H2H_SOUND_ID_HAND_LAND,*p\screenPosition\x+#HITBOX_SHIFT_X+#HITBOX_SIZE/2,40+playerGetWeight(*p)*10)
			Else
				psound(#H2H_SOUND_ID_HAND_FALL,*p\screenPosition\x+#HITBOX_SHIFT_X+#HITBOX_SIZE/2,70+playerGetWeight(*p)*10)
			EndIf
		EndIf
		If playerGetLand(*p)
			playerResetAnimationTo(*p,playerGetLand(*p))
		Else
			playerResetAnimationTo(*p,playerGetIdle(*p))
		CompilerIf #H2H_MODE=#H2H_MODE_SAVE
		Debug "No land animation !"
		CompilerEndIf
		EndIf
; 		Debug "land 2"
		*p\yPerturbation=0
	EndIf
EndProcedure
Procedure playerGetHitBoxX(*p.player)
	If *p\lockedDirection
		ProcedureReturn *p\position\x+#HITBOX_BACKSHIFT_X
	EndIf
	ProcedureReturn *p\position\x+#HITBOX_SHIFT_X
EndProcedure

Macro playerGetHitBoxCenterX(p)
	(playerGetHitBoxX(p)+#HITBOX_SIZE/2)
EndMacro

Macro playerGetHitBoxY(p)
	(p\position\y+#HITBOX_SHIFT_Y)
EndMacro

Macro playerGetHitBoxCenterY(p)
	(playerGetHitBoxY(p)+#HITBOX_SIZE/2)
EndMacro

Procedure playerDistanceHitBox(*p1.player,*p2.player)	
	Static l1.location
	set(l1,playerGetHitBoxCenterX(*p1),playerGetHitBoxCenterY(*p1))
	Static l2.location
	set(l2,playerGetHitBoxCenterX(*p2),playerGetHitBoxCenterY(*p2))
	ProcedureReturn locationDistance(l1,l2)
EndProcedure

Procedure playerPush(*pusher.player,*pushed.player,*b.background,delta.f=1)
	If Not isPlayerAlive(*pusher) Or Not isPlayerAlive(*pushed) Or *pusher\attacking Or *pushed\attacking ;Or Not isPlayerAnimationType(*pusher,#H2H_ANIMATIONTYPE_FRONT)
		ProcedureReturn
	EndIf
	; TODO 2D push with angle
	;angle.f=locationAngle(*pusher\position,*pushed\position)
	If playerDistanceHitBox(*pusher,*pushed)<#HITBOX_SIZE
		pusherForce.f=playerGetPushPower(*pusher)-playerGetWeight(*pushed)*PLAYER_BULLDOZE_WEIGHT_HINDRANCE
		If playerHasBadge(*pusher,#H2H_STANCE_BADGE_BULLDOZER)
			pusherForce*#H2H_STANCE_BADGE_BULLDOZER_PUSH_FACTOR
		EndIf
		pushedForce.f=playerGetPushPower(*pushed)-playerGetWeight(*pusher)*PLAYER_BULLDOZE_WEIGHT_HINDRANCE
		If playerHasBadge(*pushed,#H2H_STANCE_BADGE_BULLDOZER)
			pushedForce*#H2H_STANCE_BADGE_BULLDOZER_RESISTANCE_FACTOR
		EndIf
		powerDifference=pusherForce-pushedForce
; 		Debug "power difference "+pusherForce+" vs "+pushedForce+" :"+powerDifference
		If powerDifference<0
; 			Debug "swap"
			powerDifference=-powerDifference
			Swap pushedForce, pusherForce
			Swap *pusher, *pushed
		EndIf
		If pushedForce<0
			pusherForce-pushedForce
			pushedForce=0
		EndIf
; 		Debug "it is now "+pusherForce+" vs "+pushedForce
		factor.f=1
		If powerDifference=0
			factor=0.5
		Else
			factor=pusherForce/(pusherForce+pushedForce)
		EndIf
		dist.f=Abs(playerGetHitBoxCenterX(*pusher)-playerGetHitBoxCenterX(*pushed))-#HITBOX_SIZE
; 		Debug "das push, distance is now "+dist
		If dist<0
			dist=-dist
			If *pusher\position\x>*pushed\position\x
				; Pusher is left to pushed
				*pushed\position\x-dist*factor
				*pusher\position\x+dist*(1-factor)
			Else
				*pushed\position\x+dist*factor
				*pusher\position\x-dist*(1-factor)
			EndIf
		EndIf
		If playerBorderCheck(*pushed,*b)
			If *pusher\position\x>*pushed\position\x
				; Pusher is left to pushed
				*pusher\position\x=*pushed\position\x
				*pusher\position\x+playerDistanceHitBox(*pusher,*pushed)
			Else
				*pusher\position\x=*pushed\position\x
				*pusher\position\x-playerDistanceHitBox(*pusher,*pushed)
			EndIf
		EndIf
 	EndIf
 EndProcedure

Procedure playerGetMovementSpeed(*p.player)
	ProcedureReturn PLAYER_MOVEMENT_SPEED_BASE+playerGetSpeed(*p)*PLAYER_MOVEMENT_SPEED_PER_SPEED-max(playerGetWeight(*p)-playerGetStrength(*p))*PLAYER_MOVEMENT_SPEED_HINDRANCE
EndProcedure

Macro playerCanDoNext(p)
	Bool(animationCanDoNext(p\currentAnimation,p\frameIndicator-1))
EndMacro

Procedure playerSpawnWind(*p.player,*b.background=0)
	If windEnabled=#H2H_FRAME_WIND_MODE_DISABLED
		ProcedureReturn
	EndIf
	display=#True
	If windEnabled=#H2H_FRAME_WIND_MODE_ONLY_ACTIVE
		display=*p\currentFrame\hurtId
	EndIf
	If Not *p\spawnedWind And display
		If frameWindNeedCatch(*p\currentAnimation\frames(*p\currentAnimation\index))
			If *p\hasHitSomeone
				animationSpawnWind(*p\currentAnimation,*p\position,*p\lockedDirection,playerGetColor(*p),255,playerGetColorIntensity(*p),*b\white)
				*p\spawnedWind=#True
			EndIf
		Else
			animationSpawnWind(*p\currentAnimation,*p\position,*p\lockedDirection,playerGetColor(*p),255,playerGetColorIntensity(*p),*b\white)
			*p\spawnedWind=#True
		EndIf
	EndIf
EndProcedure

Declare damageGadgetCreate(*who.player,*whatRef.animation,*whatAnimation.animation,x.i,y.i,*b.background)

Procedure playerSpawnProjectile(*p.player,*b.background=0)
	If Not *p\spawnedProjectile
		If *p\currentAnimation\projectiles()
			For p=0 To ArraySize(*p\currentAnimation\projectiles(),2)
; 				If *p\currentAnimation\projectiles(*p\currentAnimation\index,p)
; 					Debug "spawned projectile "+*p\currentAnimation\index
; 				EndIf
				damageGadgetCreate(*p,*p\currentAnimation,*p\currentAnimation\projectiles(*p\currentAnimation\index,p),*p\position\x,*p\position\y,*b)
			Next
		EndIf
		*p\spawnedProjectile=#True
	EndIf
EndProcedure

Macro playerSelectIdle(p)
	playerResetAnimationTo(p,classSelectIdle(p\class,p\currentAnimation))
EndMacro

#H2H_PLAYER_CAN_MOVE_AT_CANDONEXT=#True
Procedure playerStickToGround(*p.player,*b.background)
	If *p\position\y>=groundLevel And Not animationIsUngrounded(*p\currentAnimation)
		*p\controlState\jump=0
		*p\gravity=0
		*p\deltaPush\y=0
		If Not *p\attacking
			If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_SPAWN) And Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_DEATH)
				If *p\position\y>groundLevel Or Not *p\landed
					*p\deltaAttack\y=0
					playerLand(*p,*b)
				EndIf
			EndIf
		EndIf
		*p\deltaMovement\y=0
; 		If Not *p\landed
; 			Debug "land 3"
; 		EndIf
		*p\landed=1
		If *p\position\y>groundLevel
			Debug *p\currentAnimation\name+" is not ungrounded"
			*p\position\y=groundLevel
		EndIf
	Else
		*p\landed=0
	EndIf
EndProcedure
Procedure.i playerPlayFrameSound(*p.player)
	shiftX=#HITBOX_SHIFT_X+#HITBOX_SIZE/2
	If *p\direction
		shiftX=#HITBOX_BACKSHIFT_X+#HITBOX_SIZE/2
	EndIf
	ProcedureReturn framePlaySound(*p\currentFrame,*p\screenPosition\x+shiftX,*p\classStanceId)
EndProcedure

Procedure.d animationTypeGetScore(t.i)
	Select t
		Case #H2H_ANIMATIONTYPE_NEUTRAL
			ProcedureReturn PLAYER_STAMINA_NEUTRAL_COST
		Case #H2H_ANIMATIONTYPE_NSIDE
			ProcedureReturn PLAYER_STAMINA_SIDE_COST
		Case #H2H_ANIMATIONTYPE_NBACK
			ProcedureReturn PLAYER_STAMINA_BACK_COST
		Case #H2H_ANIMATIONTYPE_NUP
			ProcedureReturn PLAYER_STAMINA_UP_COST
		Case #H2H_ANIMATIONTYPE_NDOWN
			ProcedureReturn PLAYER_STAMINA_DOWN_COST
		Case #H2H_ANIMATIONTYPE_HEAVY
			ProcedureReturn PLAYER_STAMINA_HEAVY_COST
	EndSelect
	ProcedureReturn 0
EndProcedure
	
Macro animationGetScore(a)
	animationTypeGetScore(a\animationType)
EndMacro

Procedure playerRefresh(*p.player,*b.background,delta.d=1)
	Protected score.d
	; 	Debug "loop for "+*p\name
;  	*p\hasHitSomeone=1 ; FOR TEST
	Protected speed.d=0
	If *p\life<=0
		; dead
		If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_DEATH)
			If playerGetDeath(*p)
				playerResetAnimationTo(*p,playerGetDeath(*p))
				playerPlayFrameSound(*p)
			EndIf
		EndIf
		If *p\currentAnimation\index=ArraySize(*p\currentAnimation\frames())
			If *p\frameIndicator>=*p\currentFrame\length
				*p\frameIndicator=*p\currentFrame\length-1
			EndIf
		EndIf
	EndIf
	If Not *p\currentAnimation
		*p\attacking=0
		playerResetAnimationTo(*p,playerGetIdle(*p))
	CompilerIf #H2H_MODE=#H2H_MODE_SAVE
		Debug "current animation is null"
		CompilerEndIf
	EndIf
	*previousAnimation.animation=*p\currentAnimation
	*previousFrame.frame=*p\currentFrame
	Protected init=0
	If Not animationIsAttack(*p\currentAnimation)
		*p\attacking=0
	EndIf
	;----- natural life regen
	If *p\tmpHitMode<0
		If isPlayerAlive(*p)
			tickCeil=PLAYER_REGEN_TICK_BASE-playerGetStamina(*p)*PLAYER_REGEN_TICK_DECREMENT
			If tickCeil<1
				tickCeil=1
			EndIf
			While *p\regenTick>=tickCeil And *p\life<*p\maxLife And *p\life<PLAYER_HP_BASE And *p\regenTotal<playerGetRegenMax(*p)
				*p\regenTick-tickCeil
				*p\life+1
				*p\regenTotal+1
			Wend
			If *p\life<*p\maxLife
				If playerHasBadge(*p,#H2H_STANCE_BADGE_RESILLIENT)
					*p\regenTick+delta*#H2H_STANCE_BADGE_RESILLIENT_REGEN_FACTOR
				Else
					*p\regenTick+delta
				EndIf
			Else
				*p\regenTick=0
			EndIf
		Else
			*p\regenTick=0
		EndIf
		;----- dodge reload
		Protected dodgeReloadSpeed.d=1
		If playerHasBadge(*p,#H2H_STANCE_BADGE_NERVOUS)
			dodgeReloadSpeed*#H2H_STANCE_BADGE_NERVOUS_DODGE_DURATION_FACTOR
		EndIf
		If playerHasBadge(*p,#H2H_STANCE_BADGE_EVADER)
			dodgeReloadSpeed*#H2H_STANCE_BADGE_EVADER_DODGE_RELOAD_FACTOR
		EndIf
		If *p\dodge>0
			*p\dodge-delta*dodgeReloadSpeed
; 			If *p\dodge<25 And *p\dodge>getDodgeMin(*p) And Not *p\pushed\jump
; 				*p\dodge=getDodgeMin(*p) ; ???
; 			EndIf
			If *p\dodge<0
				*p\dodge=-playerGetDodgeReload(*p)
				If playerGetAnimationType(*p)=#H2H_ANIMATIONTYPE_IDLE
					playerResetAnimationTo(*p,playerGetIdle(*p))
				EndIf
			EndIf
		Else
			If nervous
				*p\dodge+delta*#H2H_STANCE_BADGE_NERVOUS_DODGE_RELOAD_FACTOR
			Else
				*p\dodge+delta
			EndIf
			If *p\dodge>0
				*p\dodge=0
			EndIf
		EndIf
		;----- jump reload
		If *p\jumpReload>0
			*p\jumpReload-delta
			If *p\jumpReload<0
				*p\jumpReload=0
			EndIf
		EndIf
	EndIf
	If *p\hitMode>=0 Or *p\controlState\jump Or *p\gravity Or *p\guard<=0 Or *p\attacking
		*p\parry=0
; 		Debug "parry reset through guard"
	EndIf
	If *p\parry>0 And Not playerHasCommand(*p,#H2H_CONTROL_PARRY)
		*p\parry-delta
		If *p\parry<=0
			*p\parry=0
		EndIf
	EndIf
	; Guard decay when dead
	If Not isPlayerAlive(*p)
		If *p\guard>0
			*p\guard-delta
			If *p\guard<0
				*p\guard=0
			EndIf
		Else
			*p\guard+delta
			If *p\guard>0
				*p\guard=0
			EndIf
		EndIf
	EndIf
	If isPlayerAlive(*p) And Not *p\caught And Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_SPAWN) And *p\recovery<=playerGetAgility(*p)*PLAYER_RECOVERY_AGILITY_SHORTCUT And *p\hitMode=-1
		;{
		;---- parry
		Protected margin.d=playerGetParryMargin(*p)
		If margin<=0
			margin=0.01 ; safeguard
		EndIf
		If Not *p\dodge And Not *p\controlState\jump And Not *p\gravity And Not *p\attacking And *p\guard>0 And Not animationIsAttack(*p\currentAnimation)
			If playerHasCommand(*p,#H2H_CONTROL_PARRY)
; 				Debug "parry command"
				If *p\parry<margin
					*p\parry+delta
					If *p\parry>margin
						*p\parry=margin
					EndIf
				Else
					*p\parry-delta
					If *p\parry<=margin
						*p\parry=margin
					EndIf
				EndIf
			EndIf
		EndIf
		;---- guard regen
		If *p\parry<=0 And *p\recovery<=0 And Not playerHasCommand(*p,#H2H_CONTROL_PARRY)
			playerGuardRegen(*p)
		EndIf	
		If (Not *p\attacking Or (playerCanDoNext(*p) And animationIsComboEnd(*p\currentAnimation) And *p\hasHitSomeone And *p\blocked<=0)) And *p\parry<=0; And *p\guard>0
		   ;----- dodge
			If Not *p\dodge And Not *p\controlState\jump And Not *p\gravity And playerHasCommand(*p,#H2H_CONTROL_DODGE)
				*p\dodge=PLAYER_DODGE_BASE
			EndIf
			#H2H_PLAYER_COMBO_HEIGHT_MARGIN=50
			;----- combo start
			If Not *p\controlState\jump And *p\landed And *p\dodge<=0 And *p\position\y>=groundLevel-#H2H_PLAYER_COMBO_HEIGHT_MARGIN
				comboId=-1
				*tmpAnimation.animation=0
				If playerHasCommand(*p,#H2H_CONTROL_NEUTRAL)
					comboId=#H2H_COMBO_NEUTRAL
					*tmpAnimation=playerGetNeutral(*p)
				EndIf
				If playerHasCommand(*p,#H2H_CONTROL_ATTACK_SIDE)
					comboId=#H2H_COMBO_NSIDE
					*tmpAnimation=playerGetSide(*p)
				EndIf
				If playerHasCommand(*p,#H2H_CONTROL_ATTACK_BACK)
					comboId=#H2H_COMBO_NBACK
					*tmpAnimation=playerGetBack(*p)
				EndIf
				If playerHasCommand(*p,#H2H_CONTROL_ATTACK_UP)
					comboId=#H2H_COMBO_NUP
					*tmpAnimation=playerGetUp(*p)
				EndIf
				If playerHasCommand(*p,#H2H_CONTROL_ATTACK_DOWN)
					comboId=#H2H_COMBO_NDOWN
					*tmpAnimation=playerGetDown(*p)
				EndIf
				; normal attacks have priority over heavy
				; could be evolved in future dev
				If Not *tmpAnimation And playerHasCommand(*p,#H2H_CONTROL_HEAVY)
					comboId=#H2H_COMBO_HEAVY
					*tmpAnimation=playerGetHeavy(*p)
				EndIf
				If *tmpAnimation
; 					Debug "was at height "+*p\position\y
; 					Debug "compared with "+Str(groundLevel-#H2H_PLAYER_COMBO_HEIGHT_MARGIN)
					If *p\position\y<groundLevel And Not animationIsUngrounded(*tmpAnimation)
						*p\position\y=groundLevel
; 						Debug "reset position"
					EndIf
					Select *tmpAnimation\animationType
						Case #H2H_ANIMATIONTYPE_NEUTRAL
							*p\regenTotal+PLAYER_STAMINA_NEUTRAL_COST
						Case #H2H_ANIMATIONTYPE_NSIDE
							*p\regenTotal+PLAYER_STAMINA_SIDE_COST
						Case #H2H_ANIMATIONTYPE_NBACK
							*p\regenTotal+PLAYER_STAMINA_BACK_COST
						Case #H2H_ANIMATIONTYPE_NUP
							*p\regenTotal+PLAYER_STAMINA_UP_COST
						Case #H2H_ANIMATIONTYPE_NDOWN
							*p\regenTotal+PLAYER_STAMINA_DOWN_COST
						Case #H2H_ANIMATIONTYPE_HEAVY
							*p\regenTotal+PLAYER_STAMINA_HEAVY_COST
					EndSelect
					If animationIsComboEnd(*p\currentAnimation)
						*p\recovery=0
						For i=0 To *p\comboCount-1
							Select playercombo(*p,i)
								Case #H2H_COMBO_NEUTRAL
									score+PLAYER_COMBO_SCORE_NEUTRAL
								Case #H2H_COMBO_NSIDE
									score+PLAYER_COMBO_SCORE_SIDE
								Case #H2H_COMBO_NBACK
									score+PLAYER_COMBO_SCORE_BACK
								Case #H2H_COMBO_NUP
									score+PLAYER_COMBO_SCORE_UP
								Case #H2H_COMBO_NDOWN
									score+PLAYER_COMBO_SCORE_DOWN
								Case #H2H_COMBO_HEAVY
									score+PLAYER_COMBO_SCORE_HEAVY
							EndSelect
						Next
						If score>0
							*p\regenTotal-Int(score*PLAYER_COMBO_SCORE_FACTOR)
						EndIf
					EndIf
					If *p\regenTotal>playerGetRegenMax(*p)
						*p\regenTotal=playerGetRegenMax(*p)
					EndIf
					If *p\regenTotal<0
						*p\regenTotal=0
					EndIf
					*p\recovery=0
					playerComboReset(*p)
					*p\comboCount=1
					playerResetAnimationTo(*p,*tmpAnimation)
					playerPlayFrameSound(*p)
					;-- spawn wind
					playerSpawnWind(*p,*b)
					playerSpawnProjectile(*p,*b)
					mustSpawnStuff=#False
;  					Debug "new start at "+*p\currentAnimation\name+" towards "+*p\lockedDirection
					playerComboDirectionSet(*p,0,*p\lockedDirection)
					playerComboSet(*p,0,comboId)
					playerComboSizeSet(*p,0,1)
					playerComboHitSet(*p,0,0)
; 					Debug "Cleared 1"
					ClearList(*p\hit())
					*p\attacking=1 
					init=1
				EndIf
			EndIf
		EndIf
		
		CompilerIf #H2H_PLAYER_CAN_MOVE_AT_CANDONEXT
		cdn=Bool(playerCanDoNext(*p) And ListSize(*p\hit()) And *p\currentFrame\canMove And *p\currentFrame\canMove<=*p\frameIndicator)
		If (Not *p\attacking Or cdn) And *p\dodge<=0 And (Not playerHasCommand(*p,#H2H_CONTROL_PARRY) Or *p\gravity) ;And Not (playerHasCommand(*p,#H2H_CONTROL_ATTACK) Or playerHasCommand(*p,#H2H_CONTROL_HEAVY) Or playerHasCommand(*p,#H2H_CONTROL_DODGE) Or playerHasCommand(*p,#H2H_CONTROL_PARRY))
		CompilerElse
		If Not *p\attacking And *p\dodge<=0 (Not playerHasCommand(*p,#H2H_CONTROL_PARRY) Or *p\gravity) ; And Not (playerHasCommand(*p,#H2H_CONTROL_ATTACK) Or playerHasCommand(*p,#H2H_CONTROL_HEAVY) Or playerHasCommand(*p,#H2H_CONTROL_DODGE) Or playerHasCommand(*p,#H2H_CONTROL_PARRY))
		CompilerEndIf
			;-- move left
			;{
			If playerHasCommand(*p,#H2H_CONTROL_LEFT) And Not playerHasCommand(*p,#H2H_CONTROL_RIGHT) 
				*p\controlState\keep=1
				If *p\controlState\pushed=0
					*p\controlState\pushed=1
					If *p\lockedDirection
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
							If playerGetJump(*p)
								If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
									If playerGetLand(*p)
										If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
											playerResetAnimationTo(*p,playerGetMoveBack(*p))
											init=1
										EndIf
									Else
										playerResetAnimationTo(*p,playerGetMoveBack(*p))
										init=1
									EndIf
								EndIf
							Else
								playerResetAnimationTo(*p,playerGetMoveBack(*p))
								init=1
							EndIf
						EndIf
					Else
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT)
							If playerGetJump(*p)
								If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
									If playerGetLand(*p)
										If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
											playerResetAnimationTo(*p,playerGetMoveFront(*p))
											init=1
										EndIf
									Else
										playerResetAnimationTo(*p,playerGetMoveFront(*p))
										init=1
									EndIf
								EndIf
							Else
								playerResetAnimationTo(*p,playerGetMoveFront(*p))
								init=1
							EndIf
						EndIf
					EndIf
				EndIf
				speed=-playerGetMovementSpeed(*p)
			EndIf
			;}
			;-- move right
			;{
			If playerHasCommand(*p,#H2H_CONTROL_RIGHT) And Not playerHasCommand(*p,#H2H_CONTROL_LEFT)
				*p\controlState\keep=1
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
					If *p\controlState\pushed=0
						*p\controlState\pushed=1
						If *p\lockedDirection
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT)
								If playerGetJump(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
										If playerGetLand(*p)
											If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
												playerResetAnimationTo(*p,playerGetMoveFront(*p))
												init=1
											EndIf
										Else
											playerResetAnimationTo(*p,playerGetMoveFront(*p))
											init=1
										EndIf
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveFront(*p))
									init=1
								EndIf
							EndIf
						Else
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
								If playerGetJump(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
										If playerGetLand(*p)
											If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
												playerResetAnimationTo(*p,playerGetMoveBack(*p))
												init=1
											EndIf
										Else
											playerResetAnimationTo(*p,playerGetMoveBack(*p))
											init=1
										EndIf
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveBack(*p))
									init=1
								EndIf
							EndIf
						EndIf
					EndIf
				EndIf
				speed=playerGetMovementSpeed(*p)
			EndIf
			;}
			;-- move both direction
			;{
			If playerHasCommand(*p,#H2H_CONTROL_RIGHT) And playerHasCommand(*p,#H2H_CONTROL_LEFT) And cdn
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
					If playerGetJump(*p)
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
							If playerGetLand(*p)
								If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
									playerResetAnimationTo(*p,playerGetIdle(*p))
									init=1
								EndIf
							Else
								playerResetAnimationTo(*p,playerGetIdle(*p))
								init=1
							EndIf
						EndIf
					Else
						playerResetAnimationTo(*p,playerGetIdle(*p))
						init=1
					EndIf
				EndIf
			EndIf
			;}
			;-- stop
			;{
			If Not *p\controlState\keep And Not *p\attacking And Not cdn
				*p\controlState\pushed=0
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
					If playerGetJump(*p)
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
							If playerGetLand(*p)
								If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
									playerResetAnimationTo(*p,playerGetIdle(*p))
									init=1
								EndIf
							Else
								playerResetAnimationTo(*p,playerGetIdle(*p))
								init=1
							EndIf
						EndIf
					Else
						playerResetAnimationTo(*p,playerGetIdle(*p))
						init=1
					EndIf
				EndIf
				speed=0
			EndIf
			;}
			;-- Jump animation shenaningans
			;{
			If speed>0
				If *p\lockedDirection
					If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT)
						If playerGetJump(*p)
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
								If playerGetLand(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
										playerResetAnimationTo(*p,playerGetMoveFront(*p))
										init=1
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveFront(*p))
									init=1
								EndIf
							EndIf
						Else
							playerResetAnimationTo(*p,playerGetMoveFront(*p))
							init=1
						EndIf
					EndIf
				Else
					If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
						If playerGetJump(*p)
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
								If playerGetLand(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
										playerResetAnimationTo(*p,playerGetMoveBack(*p))
										init=1
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveBack(*p))
									init=1
								EndIf
							EndIf
						Else
							playerResetAnimationTo(*p,playerGetMoveBack(*p))
							init=1
						EndIf
					EndIf
				EndIf
			EndIf
			If speed<0
				If *p\lockedDirection
					If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
						If playerGetJump(*p)
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
								If playerGetLand(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
										playerResetAnimationTo(*p,playerGetMoveBack(*p))
										init=1
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveBack(*p))
									init=1
								EndIf
							EndIf
						Else
							playerResetAnimationTo(*p,playerGetMoveBack(*p))
							init=1
						EndIf
					EndIf
				Else
					If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT)
						If playerGetJump(*p)
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
								If playerGetLand(*p)
									If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
										playerResetAnimationTo(*p,playerGetMoveFront(*p))
										init=1
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetMoveFront(*p))
									init=1
								EndIf
							EndIf
						Else
							playerResetAnimationTo(*p,playerGetMoveFront(*p))
							init=1
						EndIf
					EndIf
				EndIf
			EndIf
			If speed=0 And Not cdn
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE) 
					If playerGetJump(*p)
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
							If playerGetLand(*p)
								If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
									playerResetAnimationTo(*p,playerGetIdle(*p))
									init=1
								EndIf
							Else
								playerResetAnimationTo(*p,playerGetIdle(*p))
								init=1
							EndIf
						EndIf
					Else
						playerResetAnimationTo(*p,playerGetIdle(*p))
						init=1
					EndIf
				EndIf
			EndIf
			;}
			If Not cdn And ListSize(*p\hit())>0
; 				Debug "Cleared 2"
				ClearList(*p\hit())
			EndIf
		EndIf
	;}
	EndIf
	;----- gravity And jump
	;{
	;-- jump detection
	If isPlayerAlive(*p) And playerHasCommand(*p,#H2H_CONTROL_JUMP) And *p\dodge<=0 And *p\recovery<=0 And *p\hitMode=-1 And Not *p\caught
; 		Debug "jump ? "+playerHasCommand(*p,#H2H_CONTROL_JUMP)
		If Not *p\attacking Or cdn
			If Not *p\controlState\jump And *p\landed And *p\jumpReload=0
				If *p\position\y<=groundLevel
					set(*p\deltaMovement,*p\deltaMovement\x,playerGetJumpPower(*p)) ;---- jump formula
					*p\gravity=1
					*p\controlState\jump=1
					If playerGetJump(*p)
						playerResetAnimationTo(*p,playerGetJump(*p))
					EndIf
					If playerGetWeight(*p)>PLAYER_WEIGHT_LAND_THRESHOLD
						psound(#H2H_SOUND_ID_HAND_JUMPHEAVY,*p\screenPosition\x+#HITBOX_SHIFT_X+#HITBOX_SIZE/2,40+playerGetWeight(*p)*10)
					Else
						psound(#H2H_SOUND_ID_HAND_JUMPLIGHT,*p\screenPosition\x+#HITBOX_SHIFT_X+#HITBOX_SIZE/2,70+playerGetWeight(*p)*10)
					EndIf
					*p\regenTotal+PLAYER_STAMINA_JUMP_COST
					If *p\regenTotal>playerGetRegenMax(*p)
						*p\regenTotal=playerGetRegenMax(*p)
					EndIf
					If *p\regenTotal<0
						*p\regenTotal=0
					EndIf
				EndIf
			EndIf
		EndIf
	EndIf
	
	;-- gravity and grounding
	If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_SPAWN) And Not animationIsAttack(*p\currentAnimation)
		If (*p\controlState\jump Or Not (*p\hasMoved Or *p\currentFrame\movement)) And  Not *p\caught
			If *p\position\y<=groundLevel
				If *p\position\y<>groundLevel
					If Not *p\controlState\jump
						*p\gravity=1
						*p\landed=0
					EndIf
				EndIf
			Else
				;grounded
				*p\controlState\jump=0
				*p\position\y=groundLevel
				*p\gravity=0
; 				If Not *p\landed
; 					Debug "land 1"
; 				EndIf
				; playerStickToGround(*p,*b)
				;*p\land=0
				*p\deltaPush\y=0
				If Abs(*p\deltaMovement\y)<8
					If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
						playerResetAnimationTo(*p,playerGetIdle(*p))
					EndIf
				Else
					playerJumpReload(*p)
					playerLandEffectSpawn(*p)
					playerShakeGround(*p)
					If Not *p\attacking
						If playerGetLand(*p)
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
								playerResetAnimationTo(*p,playerGetLand(*p))
							EndIf
						Else
							If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
								playerResetAnimationTo(*p,playerGetIdle(*p))
							EndIf
						EndIf
					EndIf
				EndIf
				*p\deltaMovement\y=0
			EndIf
		EndIf
	EndIf
	If *p\gravity And Not *p\caught
		set(*p\deltaMovement,*p\deltaMovement\x,*p\deltaMovement\y+PLAYER_GRAVITY*delta) ;--- gravity formula
		If *p\position\y>groundLevel
			*p\gravity=0
			*p\position\y=groundLevel
			*p\controlState\jump=0
			playerLand(*p,*b)
			*p\deltaMovement\y=0
			; 			playerStickToGround(*p,*b)
			;*p\land=0
			*p\deltaPush\y=0
		Else
			*p\landed=0
; 										Debug "airborne 6"
			;-- jump animation while falling
			If playerGetJump(*p) And Not *p\attacking And *p\position\y<groundLevel And *p\hitMode=-1
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP) And *p\position\y<groundLevel-20
; 					Debug "fall ?"
					playerResetAnimationTo(*p,playerGetJump(*p))
				EndIf
				base=-playerGetJumpPower(*p)
				current=*p\deltaMovement\y
				max=ArraySize(playerGetJump(*p)\frames())
				If current>=base
					*p\currentFrame=*p\currentAnimation\frames(max)
					*p\currentAnimation\index=max
				Else
					i=(max+1)*((current+base))/(base*2)
					If i>max
						i=max
					EndIf
					If i>ArraySize(*p\currentAnimation\frames())
						i=ArraySize(*p\currentAnimation\frames())
					EndIf
					*p\currentFrame=*p\currentAnimation\frames(i)
					*p\currentAnimation\index=i
				EndIf
			EndIf
		EndIf
	EndIf
	;----- air resistance
	CompilerIf #H2H_AIR_RESISTANCE_ENABLE
		excess.f=Abs(*p\deltaMovement\x)-#H2H_AIR_RESISTANCE_CAP
		If excess>0
			excess*#H2H_AIR_RESISTANCE_PERCENT/100
			*p\deltaMovement\x-(excess*Sign(*p\deltaMovement\x))*delta
		EndIf
		
		excess.f=Abs(*p\deltaMovement\y)-#H2H_AIR_RESISTANCE_CAP
		If excess>0
			excess*#H2H_AIR_RESISTANCE_PERCENT/100
			*p\deltaMovement\y-(excess*Sign(*p\deltaMovement\y))*delta
		EndIf
		
		excess.f=Abs(*p\deltaPush\x)-#H2H_AIR_RESISTANCE_CAP
		If excess>0
			excess*#H2H_AIR_RESISTANCE_PERCENT/100
			*p\deltaPush\x-(excess*Sign(*p\deltaPush\x))*delta
		EndIf
		
		excess.f=Abs(*p\deltaPush\y)-#H2H_AIR_RESISTANCE_CAP
		If excess>0
			excess*#H2H_AIR_RESISTANCE_PERCENT/100
			*p\deltaPush\y-(excess*Sign(*p\deltaPush\y))*delta
		EndIf
	CompilerEndIf
	
	;----- refresh position based on delta
	locationAdd(*p\position,*p\deltaMovement\x*delta,*p\deltaMovement\y*delta)
	locationAdd(*p\position,*p\deltaAttack\x*delta,*p\deltaAttack\y*delta)
	locationAdd(*p\position,*p\deltaPush\x*delta,*p\deltaPush\y*delta)

	;----- stabilize delta
	; 	locationMult(*p\deltaMovement,Pow(0.5,delta),1) ; old
	If speed
		*p\deltaMovement\x=lerp(*p\deltaMovement\x,speed,min(0.5*delta,1)) ; new
	Else
		; for harder breaking, imitating the older behavior
		*p\deltaMovement\x=lerp(*p\deltaMovement\x,speed,min(2*delta,1))
	EndIf
	factor.d=0.5
	If *p\hitMode>-1
		factor=0.475
	EndIf
	*p\deltaPush\x=lerp(*p\deltaPush\x,0,min(factor*delta,1))
	*p\deltaPush\y=lerp(*p\deltaPush\y,0,min(0.1*delta,1))

	;- stick player to ground
	If Not *p\currentFrame\movement And Not *p\caught And Not *p\hasMoved
		playerStickToGround(*p,*b)
	EndIf
	*p\controlState\keep=0
	;}
	;----- border check
	playerBorderCheck(*p,*b)
	
	;----- increase the frame
	If playerHasBadge(*p,#H2H_STANCE_BADGE_NERVOUS)
		*p\sub+delta*#H2H_STANCE_BADGE_NERVOUS_DELTA
		If *p\hitMode<0 ; if not stunned
			*p\recovery-delta*#H2H_STANCE_BADGE_NERVOUS_DELTA
		EndIf
	Else
		*p\sub+delta
		*p\recovery-delta
	EndIf
	If *p\recovery<0
		*p\recovery=0
	EndIf
	Protected difference.i=0
	;---- recovery animation end
	If *p\recovery>0 And *p\hitMode=-1
		If isPlayerAlive(*p) And Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
			If playerGetJump(*p)
				If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
					If playerGetLand(*p)
						If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
							playerResetAnimationTo(*p,playerGetIdle(*p))
							init=1
						EndIf
					Else
						playerResetAnimationTo(*p,playerGetIdle(*p))
						init=1
					EndIf
				EndIf
			Else
				playerResetAnimationTo(*p,playerGetIdle(*p))
				init=1
			EndIf
		EndIf
	EndIf
	If ArraySize(*p\currentAnimation\frames())<>-1
		;{
		difference=Int(*p\sub)
		If difference
			*p\sub-difference
			If Not (isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_HIT) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP))
				*p\frameIndicator+difference
			EndIf
			;-- feedback
			*p\feedback-difference
			If *p\feedback>50 ; TODO constant
				*p\feedback-difference
			EndIf
			If *p\feedback<0
				*p\feedback=0
			EndIf
		EndIf
		If Not *p\currentAnimation
			*p\frameIndicator+420
		EndIf
		Protected length.d=*p\currentFrame\length
		If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
			length*(PLAYER_MOVEMENT_SPEED_BASE*2.0)
			length/(PLAYER_MOVEMENT_SPEED_BASE+playerGetSpeed(*p)*PLAYER_MOVEMENT_SPEED_PER_SPEED)
			length=max(length,1)
		EndIf
		Protected canDoNext=Bool(playerCanDoNext(*p) And *p\hasHitSomeone And Not *p\blocked)
		While *p\frameIndicator>length Or canDoNext
			;{
			;-- change the frame
			wasHigher=Bool(*p\frameIndicator>length)
			mustSpawnStuff=#False
			Protected animationEnd=0
			If Not canDoNext
				*p\frameIndicator-length
				*p\currentAnimation\index+1
				; -- next animation index
				If animationIndex(*p\currentAnimation)<=ArraySize(*p\currentAnimation\frames())
					;- next frame here
					*p\currentFrame=*p\currentAnimation\frames(*p\currentAnimation\index)
					length=*p\currentFrame\length
					*p\spawnedWind=#False
					*p\spawnedProjectile=#False
					*p\hasMoved=0
					;-- increase the frame and check movement
; 					If *p\blocked<=0
 						playerApplyMovement(*p)
; 					EndIf
					;- spawn wind
					If *p\hitMode=-1 And *p\dodge<=0 And *p\parry<=0
						mustSpawnStuff=#True
					EndIf
					;-- damage cut
					If frameIsDamageCut(*p\currentFrame)
; 						Debug "Cleared 6"
						ClearList(*p\hit())
					EndIf
				Else
					*p\currentAnimation\index=ArraySize(*p\currentAnimation\frames())
					If wasHigher
						animationEnd=1
; 						Debug "was higher"
					EndIf
				EndIf
			EndIf
			; next element
			;-- If there's no new replaced animation
			If Not init
; 				If *p\blocked>0
; 					*p\blocked-1
; 					If isPlayerAlive(*p) And *p\blocked<=0
; 						playerResetAnimationTo(*p,playerGetIdle(*p))
; 						*p\recovery+(10-playerGetAgility(*p))
; 					EndIf
; 				Else
					If ArraySize(*p\currentAnimation\frames())<animationIndex(*p\currentAnimation)
						; Here the animation ends
						animationEnd=1
; 						Debug "animation ends"
					EndIf
; 				EndIf
			EndIf
			If animationEnd Or canDoNext ;:Debug "end "+animationEnd+" "+canDoNext
				;-- animation end
				If playerGetSpawn(*p)
					If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_SPAWN)
						playerResetAnimationTo(*p,playerGetIdle(*p))
					EndIf
				EndIf
				If playerGetLand(*p)
					If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
						playerResetAnimationTo(*p,playerGetIdle(*p))
					EndIf
				EndIf
				If animationIsLooped(*p\currentAnimation)
					;-- restart
					If Not canDoNext Or animationEnd
						*p\blocked=#False
						*p\currentAnimation\index=*p\currentAnimation\loopStart ; by default 0
						*p\currentFrame=*p\currentAnimation\frames(*p\currentAnimation\index)
						;-- idle variants
						If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE)
							playerSelectIdle(*p)
						EndIf
					EndIf
				Else
; 					Debug "check "+*p\landed+" "+Str(animationIsUngrounded(*p\currentAnimation))
					If isPlayerAlive(*p) And *p\recovery<=0 And *p\hitMode=-1 And Not *p\caught; And (*p\landed Or animationIsUngrounded(*p\currentAnimation))
						;-- low recovery
						If *p\attacking
							; must be attacking
							If *p\hasHitSomeone
								;-- The previous attack hit someone
								Protected tmpRecovery=*p\currentAnimation\recovery
								*tmpAnimation.animation=#Null
								If playerHasCommand(*p,#H2H_CONTROL_NEUTRAL)
									*tmpAnimation=animationGetNeutral(*p\currentAnimation)
								EndIf
								If playerHasCommand(*p,#H2H_CONTROL_ATTACK_SIDE)
									*tmpAnimation=animationGetSide(*p\currentAnimation)
								EndIf
								If playerHasCommand(*p,#H2H_CONTROL_ATTACK_BACK)
									*tmpAnimation=animationGetBack(*p\currentAnimation)
								EndIf
								If playerHasCommand(*p,#H2H_CONTROL_ATTACK_UP)
									*tmpAnimation=animationGetUp(*p\currentAnimation)
								EndIf
								If playerHasCommand(*p,#H2H_CONTROL_ATTACK_DOWN)
									*tmpAnimation=animationGetDown(*p\currentAnimation)
								EndIf
								If playerHasCommand(*p,#H2H_CONTROL_HEAVY)
									*tmpAnimation=animationGetHeavy(*p\currentAnimation)
								EndIf
								If Not *tmpAnimation
									If canDoNext And Not animationEnd
										;-- the next combo is not valid
										canDoNext=0
									Else
										*p\hasHitSomeone=0
										score=(*p\comboCount-1)*PLAYER_COMBO_SCORE_ANY
										If animationIsComboEnd(*p\currentAnimation)
											*p\recovery=0
											For i=0 To *p\comboCount-1
												score+animationTypeGetScore(playerCombo(*p,i))
											Next
											If score>0
												If playerHasBadge(*p,#H2H_STANCE_BADGE_RESILLIENT)
													*p\regenTotal-Int(score*PLAYER_COMBO_SCORE_FACTOR)*#H2H_STANCE_BADGE_RESILLIENT_STAMINA_FACTOR
												Else
													*p\regenTotal-Int(score*PLAYER_COMBO_SCORE_FACTOR)
												EndIf
											EndIf
											If *p\regenTotal<0
												*p\regenTotal=0
											EndIf
											If *p\regenTotal>playerGetRegenMax(*p)
												*p\regenTotal=playerGetRegenMax(*p)
											EndIf
										Else
											playerRecovery(*p)
											*p\recovery*PLAYER_RECOVERY_PARTIAL_FACTOR
										EndIf
										playerComboReset(*p)
										playercomboSet(*p,0,playerComboGetId(*p))
										playerComboSizeSet(*p,0,1)
										playerComboHitSet(*p,0,0)
										playerComboDirectionSet(*p,0,*p\lockedDirection)
										*p\comboCount=1
										playerResetAnimationTo(*p,playerGetIdle(*p))
										*p\attacking=0
; 										*p\landed=0
									EndIf
								Else
									;-- combo is valid
									*p\regenTotal+animationGetScore(*tmpAnimation)
									If *p\regenTotal>playerGetRegenMax(*p)
										*p\regenTotal=playerGetRegenMax(*p)
									EndIf
									If *p\regenTotal<=0
										*p\regenTotal=0
									EndIf
									playerResetAnimationTo(*p,*tmpAnimation)
									playerPlayFrameSound(*p)
; 									Debug "Cleared 3"
									ClearList(*p\hit())
									*p\hasHitSomeone=0
									playercomboSet(*p,*p\comboCount,playerComboGetId(*p))
									playerComboDirectionSet(*p,*p\comboCount,*p\lockedDirection)
									playerComboSizeSet(*p,*p\comboCount,1)
									playerComboHitSet(*p,*p\comboCount,0)
									*p\comboCount+1
; 									Debug "combo valid"
									*p\attacking=1
									canDoNext=0
								EndIf
								c=*p\color
								If *p\class\allStances(*p\classStanceId)\specialcolor
									If *p\usesAlternate
										c=*p\class\allStances(*p\classStanceId)\alternatecolor
									Else
										c=*p\class\allStances(*p\classStanceId)\specialcolor
									EndIf
								EndIf
								mustSpawnStuff=#False
								playerSpawnWind(*p,*b)
								playerSpawnProjectile(*p,*b)
							Else
								;-- this is a miss
								*p\hasMoved=0
; 								Debug "Cleared 4"
								ClearList(*p\hit())
								*p\hasHitSomeone=0
								If Not canDoNext Or animationEnd ; can't do next or animation finished
									playerRecovery(*p)
								Else
									canDoNext=0
								EndIf
; 								*p\landed=0
							EndIf
						Else
							;-- Jump animation set
							If Not canDoNext Or animationEnd
								If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP)
									If playerGetLand(*p)
										playerResetAnimationTo(*p,playerGetLand(*p))
									Else
										playerResetAnimationTo(*p,playerGetIdle(*p))
									EndIf
								Else
									playerResetAnimationTo(*p,playerGetIdle(*p))
								EndIf
							EndIf
						EndIf
					EndIf
				EndIf
			Else
				;-- animation continues
				If isPlayerAlive(*p) And frameNeedCatch(*p\currentFrame)
					If Not *p\hasHitSomeone
						;-- recovery because nothing hited
						If animationIsComboEnd(*previousAnimation)
							*p\recovery=0
						Else
							playerRecovery(*p)
						EndIf
						playerResetAnimationTo(*p,playerGetIdle(*p))
; 						Debug *p\name+" need catch"
						*p\comboCount=0
; 						*p\landed=0
						canDoNext=0
; 						Debug "Cleared 5"
						ClearList(*p\hit())
					EndIf
				EndIf
				;-- play the current sound after we change
				; only if the next animation is correct
; 				If *p\blocked<=0
					; -- play sound
					playerPlayFrameSound(*p)
					;-- Frame shake
					If *p\currentFrame\shake
; 						Debug "shake"
						playerShakeGround(*p)
					EndIf
; 				EndIf
			EndIf
			;-- movement Delta need catch
			If *p\currentFrame\movementD
				catch=1
				If frameMovementDeltaNeedCatch(*p\currentFrame)
					If ListSize(*p\hit())>0
						catch=1
					Else
						catch=0
					EndIf
				EndIf
				If catch
					If *p\lockedDirection
						set(*p\deltaAttack,-*p\currentFrame\movementD\x,
						    				*p\currentFrame\movementD\y)
					Else
						set(*p\deltaAttack,*p\currentFrame\movementD\x,
						    			   *p\currentFrame\movementD\y)
					EndIf
				EndIf
			Else
				set(*p\deltaAttack)
			EndIf
			
			If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK)
				length=*p\currentFrame\length
				length*(PLAYER_MOVEMENT_SPEED_BASE*2)
				length/(PLAYER_MOVEMENT_SPEED_BASE+playerGetSpeed(*p)*PLAYER_MOVEMENT_SPEED_PER_SPEED)
				length=max(length,1)
			EndIf
		;}
			canDoNext=0
			If mustSpawnStuff
				playerSpawnWind(*p,*b)
				playerSpawnProjectile(*p,*b)
			EndIf
		Wend
		;}
	Else
		Debug "empty animation"
		*p\comboCount=0
		playerResetAnimationTo(*p,playerGetIdle(*p))
	EndIf

	If Not *p\currentAnimation
		Debug "empty animation 2"
		playerResetAnimationTo(*p,playerGetIdle(*p))
		*p\attacking=0
	EndIf
	;-- combo reset
	If Not *p\attacking
		If isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_IDLE) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_BACK) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_JUMP) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_DODGE) Or isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_LAND)
			*p\comboCount=0
		EndIf
	EndIf
	
	;-- perturbation
	*p\yPerturbation+Abs(*p\deltaPush\y)*delta
	If *p\yPerturbation>=PLAYER_PERTURBATION_Y And Not *p\gravity
		*p\gravity=1
		*p\landed=0
		*p\parry=0
		playerResetAnimationTo(*p,playerGetIdle(*p))
	EndIf

	If *p\currentAnimation
		If Not *p\currentAnimation
			Debug "null animation !"
		EndIf
		If *p\currentAnimation\index<0
			*p\currentAnimation\index=0
			Debug "that bastard was negative"
		EndIf
		If *p\currentAnimation\index>ArraySize(*p\currentAnimation\frames())
			*p\currentAnimation\index=ArraySize(*p\currentAnimation\frames())
			Debug "woopsie we are too far"
		EndIf
		*p\currentFrame=*p\currentAnimation\frames(*p\currentAnimation\index)
	EndIf
EndProcedure

Macro playerControlPressed(p,what)
	controlPressed(p\pushed,what)
EndMacro

Global feedbackScreen=0
#H2H_SCREEN_FEEDBACK_MARGIN=100
Macro feedbackScreenDisplay(feedback)
	If feedback
		If feedbackScreen=0
			feedbackScreen=spriteIndexAdd()
		EndIf
		If Not IsSprite(feedbackScreen)
			CreateSprite(feedbackScreen,screenSizeX,screenSizeY,#PB_Sprite_AlphaBlending)
			StartDrawing(SpriteOutput(feedbackScreen))
			Box(0,0,screenSizeX,screenSizeY,RGB(255,0,0))
			DrawingMode(#PB_2DDrawing_AlphaChannel)
			For i=1 To #H2H_SCREEN_BORDER_THICKNESS-1
				Box(i*#H2H_SCREEN_BORDER_STEP*3,i*#H2H_SCREEN_BORDER_STEP*3,screenSizeX-i*#H2H_SCREEN_BORDER_STEP*6,screenSizeY-i*#H2H_SCREEN_BORDER_STEP*6,RGBA(0,0,0,255/i))
			Next
			StopDrawing()
			ZoomSprite(feedbackScreen,SpriteWidth(feedbackScreen)+#H2H_SCREEN_FEEDBACK_MARGIN,SpriteHeight(feedbackScreen)+#H2H_SCREEN_FEEDBACK_MARGIN)
		EndIf
		DisplayTransparentSprite(feedbackScreen,-#H2H_SCREEN_FEEDBACK_MARGIN/2+(Random(feedback/10)-feedback/20)*screenShakeForceFactor,-#H2H_SCREEN_FEEDBACK_MARGIN/2+(Random(feedback/10)-feedback/20)*screenShakeForceFactor,min(255,feedback))
	EndIf
EndMacro
Procedure.i playerGetDodgeFrame(*p.player)
	If playerGetDodge(*p)
		If *p\dodge<playerGetDodgeMin(*p)
			ProcedureReturn playerGetDodge(*p)\frames(0)
		EndIf
		d.d=PLAYER_DODGE_BASE/2
		factor.d=(d-Abs(*p\dodge-d))/d
		If *p\dodge>=PLAYER_DODGE_BASE/2
			factor*2
			If factor>1
				factor=1
			EndIf
		EndIf
		ProcedureReturn animationAt(playerGetDodge(*p),factor*animationLength(playerGetDodge(*p)))
	EndIf	
	If playerGetJump(*p)
		ProcedureReturn playerGetJump(*p)\frames(ArraySize(playerGetJump(*p)\frames()))
	EndIf
	ProcedureReturn playerGetIdle(*p)\frames(0)
EndProcedure
Procedure playerDisplayShadow(*p.player,shift.i=0)
	Protected *currentFrame.frame=playerGetCurrentFrame(*p)
	If *p\hitMode>-1
		If *p\recovery>0
			If playerGetHit(*p)
				*currentFrame=playerGetHit(*p)\frames(*p\hitMode)
			EndIf
		EndIf
	Else
		If deltaDelay>0
			If playerGetHit(*p)
				If ListSize(*p\hit())=0
					If *p\tmpHitMode=-1
						*p\tmpHitMode=Random(ArraySize(playerGetHit(*p)\frames()))
					EndIf
					*currentFrame=playerGetHit(*p)\frames(*p\tmpHitMode)
				EndIf
			EndIf
		Else
			If *p\dodge>0
				*currentFrame=playerGetDodgeFrame(*p)
			Else
				If *p\parry>0
					If playerGetParry(*p)
						*currentFrame=animationAt(playerGetParry(*p),*p\parry)
					Else
						If playerGetJump(*p)
							*currentFrame=playerGetJump(*p)\frames(ArraySize(playerGetJump(*p)\frames()))
						Else
							*currentFrame=playerGetIdle(*p)\frames(ArraySize(playerGetIdle(*p)\frames()))
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf
	EndIf
	If Not *currentFrame
		ProcedureReturn
	EndIf
	frameDisplayShadow(*currentFrame,*p\screenPosition\x,*p\screenPosition\y,*p\lockedDirection,#True,playerGetColor(*p))
EndProcedure

Procedure playerDisplay(*p.player,shift.i=0,delta.d=1)
	If Not *p
		ProcedureReturn
	EndIf
	Protected feedbackColor=playerGetColor(*p)
	Protected colorIntensity=playerGetColorIntensity(*p)
	If playerColorMode<>#H2H_PLAYER_COLOR_MODE_BASIC And playerColorMode<>#H2H_PLAYER_COLOR_MODE_CONTRAST And *p\class\allStances(*p\classStanceId)\specialcolor
		If *p\usesAlternate
			feedbackColor=*p\class\allStances(*p\classStanceId)\alternatecolor
		Else
			feedbackColor=*p\class\allStances(*p\classStanceId)\specialcolor
		EndIf
	EndIf
	If *p\feedback
		m=Mod(*p\feedback,9)
		If m<3
			If Red(feedbackColor)+Green(feedbackColor)+Blue(feedbackColor)>128*3+64
				feedbackColor=RGB(64,64,64)
			Else
				feedbackColor=RGB(255,255,255)
			EndIf
		Else
			If m<6
				If feedbackColor=#H2H_STANCE_COLOR_RED
					feedbackColor=RGB(128,0,128)
				Else
					feedbackColor=RGB(255,96,96)
				EndIf
			Else
				If *p\recovery
					feedbackColor=RGB(12,12,12)
				EndIf
			EndIf
		EndIf
	Else
		If *p\recovery
			m=Mod(*p\recovery,12)
			c=*p\color
			If *p\usesAlternate And Not *p\currentStance\specialcolor
				c=*p\alternateColor
			EndIf
			If m<4
				feedbackColor=colorLerp(c,RGB(128,128,128))
			Else
				If m<8
					feedbackColor=RGB(128,128,128)
				Else
					feedbackColor=RGB(32,32,32)
				EndIf
			EndIf
		EndIf
	EndIf
	*currentFrame.frame=playerGetCurrentFrame(*p)
	If *p\hitMode>-1
		If *p\recovery>0
			If isPlayerAlive(*p)
				*currentFrame=playerGetHit(*p)\frames(*p\hitMode)
				frameLoad(*currentFrame)
			EndIf
		Else
			*p\hitMode=-1
		EndIf
	Else
		If deltaDelay>0
			If ListSize(*p\hit())=0
				If playerGetHit(*p)
					If *p\tmpHitMode=-1
						*p\tmpHitMode=Random(ArraySize(playerGetHit(*p)\frames()))
					EndIf
					*currentFrame=playerGetHit(*p)\frames(*p\tmpHitMode)
					frameLoad(*currentFrame)
				EndIf
			Else
				*p\tmpHitMode=-1
			EndIf
		Else
			*p\tmpHitMode=-1
		EndIf
		If isPlayerAlive(*p)
			If *p\dodge>0 
				*currentFrame=playerGetDodgeFrame(*p)
			EndIf
			If *p\parry
				;Debug StrD(*p\parry)
				Protected *parryA.animation=playerGetParry(*p)
				If *parryA
					Protected index.i=0
					If *p\parry<=playerGetParryMargin(*p)
						index=*p\parry/(max(playerGetParryMargin(*p),1))
					Else
						index=(*p\parry-playerGetParryMargin(*p))/PLAYER_PARRY_MARGIN_BASE+1
					EndIf
					If index>ArraySize(*parryA\frames())
						index=ArraySize(*parryA\frames())
					EndIf
					*currentFrame=*parryA\frames(index)
				Else
					If playerGetJump(*p)
						*currentFrame=playerGetJump(*p)\frames(ArraySize(playerGetJump(*p)\frames()))
					Else
						*currentFrame=playerGetIdle(*p)\frames(ArraySize(playerGetIdle(*p)\frames()))
					EndIf
				EndIf
			EndIf
		EndIf
	EndIf
	If Not *currentFrame
		ProcedureReturn
	EndIf
	*currentFrame\bufferTimeout=((*currentFrame\bufferTimeout*21)/20)+(100/*currentFrame\length)
	If *currentFrame\bufferTimeout>2000
		*currentFrame\bufferTimeout=2000
	EndIf
	Protected opacity=255
	If *currentFrame\movement
		opacity-Abs(*currentFrame\movement\x)
		opacity-Abs(*currentFrame\movement\y)
	EndIf
	If *currentFrame\movementD
		opacity-Abs(*currentFrame\movementD\x)*3
		opacity-Abs(*currentFrame\movementD\y)*3
	EndIf
	If opacity<192
		opacity=192
	EndIf
	Protected displayX.i=*p\screenPosition\x+shift+*screenShake\x
	Protected displayY.i=*p\screenPosition\y+*screenShake\y-screenFocusHeight
; 	If frameShiftYNegative(*currentFrame)
; 		displayY-*currentFrame\shift\y
; 	Else
; 		displayY+*currentFrame\shift\y
; 	EndIf
	Protected heightProportion.f=1000
	Protected heightFactor.f=1-(Abs(*p\position\y-groundLevel))/heightProportion
	If *currentFrame\shadowShift
		heightFactor+*currentFrame\shadowShift\y/heightProportion
	EndIf
	If heightFactor<0.1
		heightFactor=0.1
	EndIf
	If screenShakeMode<>#H2H_SCREEN_SHAKE_NONE And *p\hitMode>=0 And Not *p\caught
		displayX+(Random(*p\recovery)-*p\recovery/2)*screenShakeForceFactor
		displayY+(Random(*p\recovery)-*p\recovery/2)*screenShakeForceFactor
	EndIf
	Protected boost=max(224-opacity,0)*2
	feedbackColor=RGB(min(Red(feedbackColor)+boost,255),
	                  min(Green(feedbackColor)+boost,255),
	                  min(Blue(feedbackColor)+boost,255))
	If *p\dodge>0
		If playerIsDodgeActive(*p)
			opacity/4
			opacity+Abs(*p\dodge-PLAYER_DODGE_BASE/2)*2
			If opacity<0
				opacity=0
			EndIf
			colorIntensity/2
		Else
			colorIntensity/2
		EndIf
	EndIf
	If *p\parry>=playerGetParryMargin(*p)
		colorIntensity-16
	Else
		If *p\parry>0
			colorIntensity+16
		EndIf
	EndIf
	If colorIntensity<0
		colorIntensity=0
	EndIf
	If colorIntensity>255
		colorIntensity=255
	EndIf
	feedbackColor+colorIntensity<<24
	If *p\feedback Or *p\recovery
		frameDisplay(*currentFrame,displayX,displayY,opacity,feedbackColor,*p\lockedDirection)
	Else
		frameDisplay(*currentFrame,displayX,displayY,opacity,feedbackColor,*p\lockedDirection)
	EndIf
EndProcedure
Macro playerHasActiveHurtBox(p)
	Bool(Not p\currentFrame\damageDuration Or p\frameIndicator<p\currentFrame\damageDuration)
EndMacro
Procedure.i playerSelectRandomAttack(*p.player)
	Dim *attacks.animation(0)
	For i=#H2H_ANIMATIONTYPE_NEUTRAL-1 To #H2H_ANIMATIONTYPE_HEAVY-1
		If *p\class\animations[i]
			If *attacks(ArraySize(*attacks()))
				ReDim *attacks(ArraySize(*attacks())+1)
			EndIf
			*attacks(ArraySize(*attacks()))=*p\class\animations[i]
		EndIf
	Next
	*a.animation=*attacks(Random(ArraySize(*attacks())))
	FreeArray(*attacks())
	ProcedureReturn *a
EndProcedure

Procedure playerdDisplayDebug(*p.player,shift.i=0)
	*currentFrame.frame=playerGetCurrentFrame(*p)
	If Not *currentFrame
		ProcedureReturn
	EndIf
	
	Protected x.i=*p\screenPosition\x+#HITBOX_SHIFT_X
	If *p\lockedDirection
		x=*p\screenPosition\x+#HITBOX_BACKSHIFT_X
	EndIf
	Protected y.i=*p\screenPosition\y+#HITBOX_SHIFT_Y-screenFocusHeight
	
	
	Protected c=#White
	Protected b=1 ; border color
	Protected a=$80000000 ; transparency
	If *p\deltaMovement\y
		a=$FF000000
	EndIf
	Protected subY=AffTextBorder("movement : "+*p\deltaMovement\y,x,y-120,c+a,0,0.75,b+a,192)
	If *p\deltaPush\y
		a=$FF000000
	Else
		a=$80000000
	EndIf
	subY=AffTextBorder("push : "+*p\deltaPush\y,x,subY,c+a,0,0.75,b+a,192)
	If *p\gravity
		a=$FF000000
	Else
		a=$80000000
	EndIf
	subY=AffTextBorder("gravity : "+*p\gravity,x,subY,c+a,0,0.75,b+a,192)
	If *p\controlState\jump
		a=$FF000000
	Else
		a=$80000000
	EndIf
	subY=AffTextBorder("jumping : "+*p\controlState\jump,x,subY,c+a,0,0.75,b+a,192)
	subY=AffTextBorder("animation : "+*p\currentAnimation\name,x,subY,0,0,0.75,1,192)
	;subY=AffTextBorder("Delta y : "+*p\deltaMovement\y,x,subY,0,0,0.75,1,192);*p\screenPosition\y+#HITBOX_SHIFT_Y-51)
	subY=AffTextBorder("Frame "+*p\currentAnimation\id+"["+playerGetAnimationIndex(*p)+"]",x,subY,0,0,0.75,1,192)
	If Not locationIsNull(*currentFrame\movement)
		a=$FF000000
		subY=AffTextBorder("Movement : "+toString(*currentFrame\movement),x,subY,c+a,0,0.75,b+a,192)
	Else
		a=$80000000
		subY=AffTextBorder("Movement : none",x,subY,c+a,0,0.75,b+a,192)
	EndIf
	
	If animationIsAttack(*p\currentAnimation) And *currentFrame\hurtId And *currentFrame\hurtShift
		If playerHasActiveHurtBox(*p)
			frameHurtDisplay(*currentFrame,*p\screenPosition\x,*p\screenPosition\y-screenFocusHeight,128,0,*p\lockedDirection)
		Else
			frameHurtDisplay(*currentFrame,*p\screenPosition\x,*p\screenPosition\y-screenFocusHeight,32,0,*p\lockedDirection)
		EndIf
	EndIf
	; hitbox behind the sprite
	DisplaySpriteOptional(*p\hitbox,x,y,128)
	Afftext(Str(*p\screenPosition\y),*p\screenPosition\x,*p\screenPosition\y)
	Afftext(Str(*p\life)+"/"+Str(*p\maxLife),*p\screenPosition\x+#HITBOX_SHIFT_X+shift,y-17)
EndProcedure

Procedure.i playerProcessDamage(*attacker.player,*defender.player,*specificFrame.frame=#Null)
	If Not animationIsAttack(*attacker\currentAnimation)
		ProcedureReturn 0
	EndIf
	*currentFrame.frame=playerGetCurrentFrame(*attacker)
	If *specificFrame
		*currentFrame=*specificFrame
	EndIf
	If Not *currentFrame\damage
		ProcedureReturn 0
	EndIf
	
	Protected damage.d=*currentFrame\damage
	If Not frameIsPureProjectile(*currentFrame)
		Protected multiplier.d=0
		Select *currentFrame\damageType
			Case #H2H_DAMAGETYPE_BLUNT
				multiplier=(playerGetBlunt(*attacker)-5)*PLAYER_DAMAGE_BLUNT_PER_BLUNT+playerGetStrength(*attacker)*PLAYER_DAMAGE_BLUNT_PER_STRENGTH+playerGetAgility(*attacker)*PLAYER_DAMAGE_BLUNT_PER_AGILITY+playerGetSpeed(*attacker)*PLAYER_DAMAGE_BLUNT_PER_SPEED+playerGetWeight(*attacker)*PLAYER_DAMAGE_BLUNT_PER_WEIGHT
			Case #H2H_DAMAGETYPE_CUT
				multiplier=(playerGetCut(*attacker)-5)*PLAYER_DAMAGE_CUT_PER_CUT+playerGetStrength(*attacker)*PLAYER_DAMAGE_CUT_PER_STRENGTH+playerGetAgility(*attacker)*PLAYER_DAMAGE_CUT_PER_AGILITY+playerGetSpeed(*attacker)*PLAYER_DAMAGE_CUT_PER_SPEED+playerGetWeight(*attacker)*PLAYER_DAMAGE_CUT_PER_WEIGHT
			Case #H2H_DAMAGETYPE_PIERCE
				multiplier=(playerGetPierce(*attacker)-5)*PLAYER_DAMAGE_PIERCE_PER_PIERCE+playerGetStrength(*attacker)*PLAYER_DAMAGE_PIERCE_PER_STRENGTH+playerGetAgility(*attacker)*PLAYER_DAMAGE_PIERCE_PER_AGILITY+playerGetSpeed(*attacker)*PLAYER_DAMAGE_PIERCE_PER_SPEED+playerGetWeight(*attacker)*PLAYER_DAMAGE_PIERCE_PER_WEIGHT
		EndSelect
		damage*(1.0+multiplier)
	EndIf
	s.d=playerGetStamina(*defender)
	If s>0
		damage/(1.0+s*PLAYER_DAMAGE_REDUCTION_PER_STAMINA)
		If damage<1 And PLAYER_MINIMUM_DAMAGE_MODE=#H2H_PLAYER_MINIMUM_DAMAGE_RANDOM
			If Random(s)=Int(s)
				damage=1
			EndIf
		EndIf
	EndIf
	If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BRUISER) And *defender\recovery>0
		damage*#H2H_STANCE_BADGE_BRUISER_DAMAGE_FACTOR
	EndIf
	If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BALANCED)
		damage*#H2H_STANCE_BADGE_BALANCED_DAMAGE_FACTOR
	EndIf
	If playerHasBadge(*defender,#H2H_STANCE_BADGE_BALANCED)
		damage*#H2H_STANCE_BADGE_BALANCED_ARMOR_FACTOR
	EndIf
	If playerHasBadge(*attacker,#H2H_STANCE_BADGE_TECHNICIAN) And frameIsPureProjectile(*currentFrame)
		damage*#H2H_STANCE_BADGE_TECHNICIAN_DAMAGE_FACTOR ; TODO differentiate between shockwave and actual projectiles
	EndIf
	If damage<1 And PLAYER_MINIMUM_DAMAGE_MODE=#H2H_PLAYER_MINIMUM_DAMAGE_ONE
		damage=1
	EndIf
	ProcedureReturn damage
EndProcedure

#H2H_PLAYER_BLOCk_ENABLE=0

Procedure playerIsTouchingPlayer(*p1.player,*p2.player,*specificFrame.frame=#Null,*where.location=#Null)
	Protected *currentFrame.frame=*p1\currentFrame
	If *specificFrame
		*currentFrame=*specificFrame
	EndIf
	If Not *currentFrame
		*p1\currentFrame=*p1\currentAnimation\frames(*p1\currentAnimation\index)
		*currentFrame=*p1\currentFrame
	EndIf
	Protected hurtSprite=*currentFrame\hurtId
	If hurtSprite And IsSprite(hurtSprite) And Bool(*specificFrame)=Bool(*where)
		Protected hurtShiftX=shiftN(*currentFrame\hurtShift)
		Protected hurtShiftY=*currentFrame\hurtShift\y
		If *p1\lockedDirection
			hurtSprite=*currentFrame\hurtFlip
			hurtShiftX=shiftFlip(*currentFrame\hurtShift)
		EndIf
		Protected shiftX=#HITBOX_SHIFT_X
		Protected shiftY=#HITBOX_SHIFT_Y
		If *p2\lockedDirection
			shiftX=#HITBOX_BACKSHIFT_X
			shiftY=#HITBOX_BACKSHIFT_Y
		EndIf
		If frameExtended(*currentFrame)
			hurtShiftX+#H2H_LOCATION_SHIFT_CONVERT
			hurtShiftY+#H2H_LOCATION_SHIFT_CONVERT
		EndIf
		If *where
			ProcedureReturn SpritePixelCollision(hurtSprite,*where\x+hurtShiftX,*where\y+hurtShiftY,*p2\hitbox,*p2\position\x+shiftX,*p2\position\y+shiftY)
		EndIf
		ProcedureReturn SpritePixelCollision(hurtSprite,*p1\position\x+hurtShiftX,*p1\position\y+hurtShiftY,*p2\hitbox,*p2\position\x+shiftX,*p2\position\y+shiftY)
	EndIf
	ProcedureReturn #False
EndProcedure

Enumeration 0
	#H2H_PLAYER_MIRROR_ALL
	#H2H_PLAYER_MIRROR_DIFFERENT_STANCE
	#H2H_PLAYER_MIRROR_RANDOM_STANCE
EndEnumeration

Procedure playerMirror(*target.player,*model.player,mirrorMode.i=#H2H_PLAYER_MIRROR_ALL)
	Debug *target\name+" miroring "+*model\name
	*c.class=*model\class
	s=*model\classStanceId
	size=ArraySize(*c\allStances())
	If mirrorMode=#H2H_PLAYER_MIRROR_DIFFERENT_STANCE And size>0
		While s=*model\classStanceId
			s=Random(size)
		Wend
	EndIf
	If mirrorMode=#H2H_PLAYER_MIRROR_RANDOM_STANCE
		s=Random(size)
	EndIf
	playerSetClass(*target,*c,s)
EndProcedure

Procedure playerSetStance(*p.player,what.i=0)
	If what<0
		what=getRandomStanceID(*p\class)
	EndIf
	*p\classStanceId=what
	*p\currentStance=*p\class\allStances(*p\classStanceId)
 	Debug "Set "+*p\name+" stance to "+*p\currentStance\name
EndProcedure

Procedure playerSetStanceRandom(*p.player,exclusiveStanceId=-42)
	If *p And *p\class
		size=ArraySize(*p\class\allStances())
		If size>0
			playerSetStance(*p,Random(size))
			If exclusiveStanceId>-42
				While *p\classStanceId=exclusiveStanceId
					playerSetStance(*p,-1)
				Wend
			EndIf
; 			Debug "selected stance "+*p\classStanceId
		Else
			playerSetStance(*p)
		EndIf
	EndIf
EndProcedure

Procedure playerSetClassRandom(*p.player,*exclusive.player=#Null,exclusiveClass=#False,exclusiveStance=#False)
	playerSetClass(*p,*allClasses(getRandomClassID()),0)
	If (Not *p\isAI And classIsNotSelectablePlayer(*p\class)) Or (*p\isAI And classIsNotSelectableAI(*p\class))
		playerSetClassRandom(*p,*exclusive,exclusiveClass,exclusiveStance)
	Else
		If *exclusive
			If exclusiveClass
				If *p\class=*exclusive\class
					playerSetClassRandom(*p,*exclusive,exclusiveClass,exclusiveStance)
				Else
					*p\classStanceId=getRandomStanceID(*p\class)
				EndIf
			Else
				; an exclusive class can never have a similar stance
				*p\classStanceId=getRandomStanceID(*p\class)
				If exclusiveStance And ArraySize(*p\class\allStances())>0
					If *p\class=*exclusive\class
						While *p\classStanceId=*exclusive\classStanceId
							*p\classStanceId=getRandomStanceID(*p\class)
						Wend
					EndIf
				EndIf
			EndIf
			playerSetStance(*p,*p\classStanceId)
		Else
			; null exlusive player, skip the checks
			playerSetStance(*p,-1)
		EndIf
	EndIf
EndProcedure

#H2H_COMBO_DISPLAY_BIG_DISTANCE=188
#H2H_COMBO_DISPLAY_SMALL_DISTANCE=38

Procedure playerComboDisplay(*p.player,delta.d=1)
	color=playergetcolor(*p);*p\color
	intensity=playerGetColorIntensity(*p)
	distance.i=#H2H_COMBO_DISPLAY_BIG_DISTANCE
	y=0
	If comboDisplayMode=#H2H_COMBO_DISPLAY_SMALL
		distance=#H2H_COMBO_DISPLAY_SMALL_DISTANCE
		y=100
	EndIf
	If *p\comboCount>5
		distance*5.0/(*p\comboCount)
	EndIf
	factor.d=Pow(0.9,delta)
	For i=0 To *p\comboCount
		Protected combo.b=playercombo(*p,i)
		Protected shake.d=playerComboShake(*p,i)
		Protected size.d=playerComboSize(*p,i)
		Protected success.d=playerComboSuccess(*p,i)
		Protected direction.b=playerComboDirection(*p,i)
		Protected flash.d=playerComboFlash(*p,i)
		If combo
; 			Debug "alternative "+*p\usesAlternate
			opacity=128+128*playerComboHit(*p,i)
			If i>=*p\comboCount
				opacity*playercomboSize(*p,i)
			EndIf
			tmpIntensity=intensity
			If intensity<128
				tmpIntensity+flash*128
			Else
				tmpIntensity-flash*127
			EndIf
; 			Debug "shake "+i+" = "+StrD(shake)
			comboDisplayX=(screenSizeX-distance*4)/2 + screenShakeForceFactor*(Random(shake*2)-shake)
			displayComboSprite(combo,
			                   comboDisplayX+i*distance+(1-size)*distance/2,
			                   y+ distance**p\id + 		(1-size)*distance/2 + screenShakeForceFactor*(Random(shake*2)-shake),
			                   color,tmpIntensity,Bool(comboDisplayMode=#H2H_COMBO_DISPLAY_SMALL),
			                   direction,size,opacity)
			If success>0
				comboDisplayX=(screenSizeX-distance*4)/2 + screenShakeForceFactor*(Random(shake*4)-shake*2)
				displayComboSprite(combo,
				               comboDisplayX+i*distance+(1-size-success)*distance/2,
				               y+ distance**p\id + 		(1-size-success)*distance/2 + screenShakeForceFactor*(Random(shake*4)-shake*2),
				               color,tmpIntensity,Bool(comboDisplayMode=#H2H_COMBO_DISPLAY_SMALL),
				               direction,size+success,opacity*0.66)
			EndIf
		EndIf
		If i<=*p\comboCount
			playerComboShakeSet(*p,i,shake*factor)
			playerComboFlashSet(*p,i,flash*factor)
			If i<*p\comboCount
				playerComboSizeSet(*p,i,lerp(1,size,factor))
			Else
				size=lerp(size,0,factor)
				size=lerp(size,0,factor)
				If size<0.1
					size=0
					playerComboSet(*p,i,0)
				EndIf
				playerComboSizeSet(*p,i,size)
			EndIf
			success*factor
			If success<0.1
				success=0
			EndIf
			playerComboSuccessSet(*p,i,success)
		EndIf
	Next
EndProcedure
Procedure playerStun(*p.player,stun.i)
	If *p\recovery<=0
		*p\recovery=playerRecoveryCompute(*p)/2
	EndIf
	If *p\recovery<PLAYER_STUN_MAX
		*p\recovery=max(*p\recovery+stun,PLAYER_STUN_MAX)
	EndIf
	If *p\hitMode=-1 And playerGetHit(*p)
		If ArraySize(playerGetHit(*p)\frames())>-1
			playerResetAnimationTo(*p,playerGetIdle(*p))
			*p\hitMode=Random(ArraySize(playerGetHit(*p)\frames()))
			frameLoad(playerGetHit(*p)\frames(*p\hitMode))
		EndIf
	EndIf
EndProcedure

Procedure.i playerCheckGrab(*p1.player,*p2.player)
	If frameIsCatch(*p1\currentFrame)
		If playerIsTouchingPlayer(*p1,*p2)
			*p2\caught=1
			set(*p2\deltaAttack)
			set(*p2\deltaMovement)
			set(*p2\deltaPush)
		Else
			*p2\caught=0
		EndIf
	Else
		*p2\caught=0
	EndIf
EndProcedure

; Returns true if the attacker already hit the defender
; O(n)
Procedure.i playerHasHit(*attacker.player,*defender.player)
	ForEach *attacker\hit()
		If *attacker\hit()=*defender\id
			ProcedureReturn #True
		EndIf
	Next
	ProcedureReturn #False
EndProcedure

Procedure playerHitAdd(*attacker.player,*defender.player)
	AddElement(*attacker\hit())
	*attacker\hit()=*defender\id	
	*attacker\hasHitSomeone=1
EndProcedure

; check combo
Procedure playerHit(*attacker.player,*defender.player)
	playerHitAdd(*attacker,*defender)
	currentCombo=*attacker\comboCount-1
	If currentCombo<0
		currentCombo=0
	EndIf
	If currentCombo>=*attacker\comboMax
		currentCombo=*attacker\comboMax
	EndIf
	If Not playerComboHit(*attacker,currentCombo)
		playerComboHitSet(*attacker,currentCombo,1)
		If comboDisplayMode<>#H2H_COMBO_DISPLAY_NONE
			playerComboSizeSet(*attacker,currentCombo,1)
			playerComboFlashSet(*attacker,currentCombo,1)
			If animationIsComboEnd(*attacker\currentAnimation)
				playerComboSuccessSet(*attacker,currentCombo,1)
			EndIf
			freq.f=0.4+(currentCombo)*0.21
			volume.f=0.2+(currentCombo)*0.1
			shiftX=#HITBOX_SHIFT_X+#HITBOX_SIZE/2
			If *attacker\lockedDirection
				shiftX=#HITBOX_BACKSHIFT_X+#HITBOX_SIZE/2
			EndIf
; 			Debug "BONK"
			If Not demoFight
				playPoolSound(*allSoundPool(Str(#H2H_SOUND_ID_COMBO_HIT)),*attacker\screenPosition\x+shiftX,0,freq,volume)
			EndIf
		EndIf
	EndIf
EndProcedure

; checks if p1 hit p2 and adds to the p1 combo
Procedure.i playerCheckHit(*p1.player,*p2.player,*f.frame=#Null,*where.location=#Null)
	If Not (*p1 And *p2)
		ProcedureReturn #False
	EndIf
	If Not (*p1\life>0 And *p2\life>0)
		ProcedureReturn #False
	EndIf
	
; 	If *p1\blocked>0
; 		ProcedureReturn #False
; 	EndIf
	If playerIsDodgeActive(*p1) Or playerIsDodgeActive(*p2)
		ProcedureReturn #False
	EndIf
	
	If Not playerHasActiveHurtBox(*p1)
		ProcedureReturn #False
	EndIf
	If Not *f
		*f=*p1\currentFrame
	EndIf
	If Not *where
		*where=*p1\position
	EndIf
	Protected hurtSprite=*f\hurtId
	
	If hurtSprite And *f\hurtShift
		Protected hurtShiftX=shiftN(*f\hurtShift)
		Protected hurtShiftY=*f\hurtShift\y
		If frameHurtYNegative(*f)
			hurtShiftY=-hurtShiftY
		EndIf
		If *p1\lockedDirection
			hurtSprite=*f\hurtFlip
			hurtShiftX=shiftFlip(*f\hurtShift)
			If frameHurtXFlipNegative(*f)
				hurtShiftX=-hurtShiftX
			EndIf
		Else
			If frameHurtXNegative(*f)
				hurtShiftX=-hurtShiftX
			EndIf
		EndIf
		If frameExtended(*f)
			hurtShiftX+#H2H_LOCATION_SHIFT_CONVERT
			hurtShiftY+#H2H_LOCATION_SHIFT_CONVERT
		EndIf
; 		Protected shiftX=#HITBOX_SHIFT_X
; 		Protected shiftY=#HITBOX_SHIFT_Y
; 		If *p2\lockedDirection
; 			shiftX=#HITBOX_BACKSHIFT_X
; 			shiftY=#HITBOX_BACKSHIFT_Y
; 		EndIf
; 		CompilerIf #H2H_PLAYER_BLOCk_ENABLE
; 		If *p2\blocked<=0 And playerHasActiveHurtBox(*p2)
; 			*currentFrame2.frame=*p2\currentFrame
; 			Protected otherHurtSprite=*currentFrame2\hurtId
; 			If otherHurtSprite And *currentFrame2\hurtShift
; 				otherHurtShiftX=shiftN(*currentFrame2\hurtShift)
; 				otherHurtShiftY=*currentFrame2\hurtShift\y
; 				If *p2\lockedDirection
; 					otherHurtSprite=*currentFrame2\hurtFlip
; 					otherHurtShiftX=shiftFlip(*currentFrame2\hurtShift)
; 				EndIf
; 				If IsSprite(hurtSprite) And IsSprite(otherHurtSprite) And SpritePixelCollision(hurtSprite,*p1\position\x+hurtShiftX,*p1\position\y+hurtShiftY,otherHurtSprite,*p2\position\x+otherHurtShiftX,*p2\position\y+otherHurtShiftY)
; 					; blocked !
; 					*p1\blocked=(processDamage(*p2,*p1)-processDamage(*p1,*p2))
; 					If *p1\blocked<0
; 						*p1\blocked=0
; 					EndIf
; 					*p2\blocked=(processDamage(*p1,*p2)-processDamage(*p2,*p1))
; 					If *p2\blocked<0
; 						*p2\blocked=0
; 					EndIf
; 				EndIf
; 			EndIf
; 		EndIf
; 		CompilerEndIf
; 		If *p1\blocked<=0
			If playerIsTouchingPlayer(*p1,*p2,*f,*where)
				playerHit(*p1,*p2)
				ProcedureReturn #True
			EndIf
; 		EndIf
	EndIf
	ProcedureReturn #False
EndProcedure

Procedure.i playerCheckAttackColision(*p1.player,*p2.player)
	If Not *p1 Or Not *p2
		ProcedureReturn 0
	EndIf
	If *p1\id=*p2\id
		ProcedureReturn 0
	EndIf
	If *p1\attacking
		If playerHasHit(*p1,*p2)
			ProcedureReturn 0
		EndIf
; 		If *p1\blocked=0
			If *p1\currentFrame And *p1\currentFrame\damage And playerHasActiveHurtBox(*p1)
				ProcedureReturn playerCheckHit(*p1,*p2)
			EndIf
; 		EndIf
	EndIf
	ProcedureReturn 0
EndProcedure    

Procedure checkFacing(*p1.player,*p2.player)
	If *p1\position\x>*p2\position\x
		*p1\direction=0
		*p2\direction=1
	Else
		*p1\direction=1
		*p2\direction=0
	EndIf
	If Not *p1\currentAnimation Or isPlayerAnimationType(*p1,#H2H_ANIMATIONTYPE_IDLE) Or isPlayerAnimationType(*p1,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*p1,#H2H_ANIMATIONTYPE_BACK) Or isPlayerAnimationType(*p1,#H2H_ANIMATIONTYPE_LAND)
		If *p1\lockedDirection<>*p1\direction
		EndIf
		*p1\lockedDirection=*p1\direction
	EndIf
	If Not *p2\currentAnimation Or isPlayerAnimationType(*p2,#H2H_ANIMATIONTYPE_IDLE) Or isPlayerAnimationType(*p2,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*p2,#H2H_ANIMATIONTYPE_BACK) Or isPlayerAnimationType(*p2,#H2H_ANIMATIONTYPE_LAND)
		If *p2\lockedDirection<>*p2\direction
		EndIf
		*p2\lockedDirection=*p2\direction
	EndIf
EndProcedure

Macro playerGetCurrentSoundMaterial(p)
	playerGetStance(p)\materialClass(playerGetCurrentFrame(p)\damageSide)
EndMacro

Procedure playerHurtParticle(*attacker.player,*defender.player,damage.i,direction.i)
	Protected angle.f=locationAngle(*attacker\position,*defender\position)
	Protected particleLevel.f=damage*2
	particleLevel=Sqr(particleLevel)
	Protected x.f=#HITBOX_SIZE/2-32
	If *defender\direction
		x+*defender\position\x+#HITBOX_BACKSHIFT_X
	Else
		x+*defender\position\x+#HITBOX_SHIFT_X
	EndIf
	Protected y.f=*defender\position\y+#HITBOX_SHIFT_Y+#HITBOX_SIZE/2-64
	Protected size=ArraySize(*hitParticle\sprites())
	Protected start=particleLevel
	Protected dX.f=damage*Cos(angle)*2
	Protected dY.f=damage*Sin(angle)*2
	If *defender\direction
		dX*-1
	EndIf
	For i=0 To particleLevel*2
		particleAdd(*hitParticle,
		            x+Random(#HITBOX_SIZE/2)-#HITBOX_SIZE/4,
		            y+Random(#HITBOX_SIZE/2)-#HITBOX_SIZE/4,
		            dX*Random(110,90)/100.0,
		            dY*Random(110,90)/100.0,
		            particleLevel**hitParticle\lifeSpan,#H2H_PARTICLE_LAYER_BACK)
	Next
EndProcedure

Procedure.d playerGetPowerDifference(*attacker.player,*defender.player,pureProjectile.i=#False)
	Protected power.d=1.0
	If Not pureProjectile
		power=1.0+playerGetStrength(*attacker)*PLAYER_PUSH_POWER_PER_STRENGTH
		power*(1.0+playerGetAgility(*attacker)*PLAYER_PUSH_POWER_PER_AGILITY)
		power*(1.0+playerGetSpeed(*attacker)*PLAYER_PUSH_POWER_PER_SPEED)
		power*(1.0+playerGetWeight(*attacker)*PLAYER_PUSH_POWER_PER_WEIGHT)
		power*(1.0+playerGetStamina(*attacker)*PLAYER_PUSH_POWER_PER_STAMINA)
	EndIf
	power*(1.0-playerGetStrength(*defender)*PLAYER_PUSH_RESISTANCE_PER_STRENGTH)
	power*(1.0-playerGetAgility(*defender)*PLAYER_PUSH_RESISTANCE_PER_AGILITY)
	power*(1.0-playerGetSpeed(*defender)*PLAYER_PUSH_RESISTANCE_PER_SPEED)
	power*(1.0-playerGetWeight(*defender)*PLAYER_PUSH_RESISTANCE_PER_WEIGHT)
	power*(1.0-playerGetStamina(*defender)*PLAYER_PUSH_RESISTANCE_PER_STAMINA)
	ProcedureReturn power
EndProcedure


Procedure.d playerGetStunPower(*attacker.player,*defender.player,pureProjectile.i=#False)
	; (10+GetWeight(*attacker)+getStrength(*attacker))/(10+getStamina(*defender))
	Protected power.d=1.0
	If Not pureProjectile
		power=1.0+playerGetStrength(*attacker)*PLAYER_STUN_POWER_PER_STRENGTH
		power*(1.0+playerGetAgility(*attacker)*PLAYER_STUN_POWER_PER_AGILITY)
		power*(1.0+playerGetSpeed(*attacker)*PLAYER_STUN_POWER_PER_SPEED)
		power*(1.0+playerGetWeight(*attacker)*PLAYER_STUN_POWER_PER_WEIGHT)
		power*(1.0+playerGetStamina(*attacker)*PLAYER_STUN_POWER_PER_STAMINA)
	EndIf
	power*(1.0-playerGetStrength(*defender)*PLAYER_STUN_RESISTANCE_PER_STRENGTH)
	power*(1.0-playerGetAgility(*defender)*PLAYER_STUN_RESISTANCE_PER_AGILITY)
	power*(1.0-playerGetSpeed(*defender)*PLAYER_STUN_RESISTANCE_PER_SPEED)
	power*(1.0-playerGetWeight(*defender)*PLAYER_STUN_RESISTANCE_PER_WEIGHT)
	power*(1.0-playerGetStamina(*defender)*PLAYER_STUN_RESISTANCE_PER_STAMINA)
	ProcedureReturn power
EndProcedure

; Shakes the combo indicators
; Spawns the player particles
; Plays the hit sound
Procedure playerHurt(*attacker.player,*defender.player,*f.frame,damage.i,hit.i,*hSM.hitsoundMaterial,delta.d,*dg.damageGadget=#Null)
	If Not isPlayerAlive(*attacker) Or Not isPlayerAlive(*defender)
		ProcedureReturn
	EndIf
	newHit=*attacker\hasHitSomeone
	*d.damageData=0
	Protected power.d=1
; 	If frameIsPureProjectile(*f)
; 		Debug "pure"
; 	EndIf
	If hit
; 		Debug "hit"
		If damage=-999
			damage=playerProcessDamage(*attacker,*defender)
		EndIf
		power=playerGetPowerDifference(*attacker,*defender,frameIsPureProjectile(*f))
		*d=damageDataAdd(*attacker,*defender,0)
		; get the center of the hitbox
		shiftX=#HITBOX_SHIFT_X+#HITBOX_SIZE/2
		If *defender\direction
			shiftX=#HITBOX_BACKSHIFT_X+#HITBOX_SIZE/2
		EndIf
		*d\type=*f\damageType
		*d\hSM=*hSM
		*d\damage=damage
		*d\pureProjectile=frameIsPureProjectile(*f)
		playerHurtParticle(*attacker,*defender,damage,*attacker\direction)
		If *defender\life<=damage
			If Not demoFight
				If *f\damageType=#H2H_DAMAGETYPE_BLUNT
					playPoolSound(*allSoundPool(Str(#H2H_SOUND_ID_KILL_BLUNT)),*defender\screenPosition\x)
				Else
					playPoolSound(*allSoundPool(Str(#H2H_SOUND_ID_KILL_CUT)),*defender\screenPosition\x)
				EndIf
			EndIf
			screenShakeAdd(50,50)
		EndIf
		If *attacker\comboCount>0
			Protected where.b=*attacker\comboCount-1
			If Not newHit
				playerComboShakeSet(*attacker,where,20) ; TODO constant
				playerComboSizeSet(*attacker,where,1.5) ; TODO constant
			Else
				playerComboShakeSet(*attacker,where,playerComboShake(*attacker,where)+4) ; TODO constant
				playerComboSizeSet(*attacker,where,playerComboSize(*attacker,where)+0.1) ; TODO constant
			EndIf
		EndIf
		If *f\stunDuration
			*d\stun+*f\stunDuration*playerGetStunPower(*attacker,*defender,frameIsPureProjectile(*f))
			If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BULLDOZER) And Not frameIsPureProjectile(*f)
				*d\stun*#H2H_STANCE_BADGE_BULLDOZER_STUN_FACTOR
			EndIf
		EndIf
		If *f\instantPush
			; increased by strength and weight
			If *d\movedBy
				set(*d\movedBy,*f\instantPush\x*power,*f\instantPush\y*power)
			Else
				*d\movedBy=locationCreate(*f\instantPush\x*power,*f\instantPush\y*power)
			EndIf
			If *attacker\lockedDirection
				*d\movedBy\x*-1
			EndIf
		EndIf
	EndIf
	#H2H_FRAME_PUNCH_BALANCER=1.0
	*where.location=*attacker\position
	If *dg
		*where=*dg\position
	EndIf
	If playerCheckHit(*attacker,*defender,*f,*where)
		power=playerGetPowerDifference(*attacker,*defender,frameIsPureProjectile(*f))
		If Not *d
			*d=damageDataAdd(*attacker,*defender,-1)
		EndIf
		If *f\pushPowerD
			; increased by strength and weight
			If *d\inertia
				set(*d\inertia,*f\pushPowerD\x*#H2H_FRAME_PUNCH_BALANCER*power*delta,*f\pushPowerD\y*#H2H_FRAME_PUNCH_BALANCER*power*delta)
			Else
				*d\inertia=locationCreate(*f\pushPowerD\x*#H2H_FRAME_PUNCH_BALANCER*power*delta,*f\pushPowerD\y*#H2H_FRAME_PUNCH_BALANCER*power*delta)
			EndIf
			If *attacker\lockedDirection
				*d\inertia\x*-1
			EndIf
			If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BULLDOZER)
				locationMult(*d\inertia,#H2H_STANCE_BADGE_BULLDOZER_PUSH_FACTOR,#H2H_STANCE_BADGE_BULLDOZER_PUSH_FACTOR)
			EndIf
			If playerHasBadge(*defender,#H2H_STANCE_BADGE_BULLDOZER)
				locationMult(*d\inertia,#H2H_STANCE_BADGE_BULLDOZER_RESISTANCE_FACTOR,#H2H_STANCE_BADGE_BULLDOZER_RESISTANCE_FACTOR)
			EndIf
			If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BRUISER)
				locationMult(*d\inertia,#H2H_STANCE_BADGE_BRUISER_PUSH_FACTOR,#H2H_STANCE_BADGE_BRUISER_PUSH_FACTOR)
			EndIf
; 			Debug "inertia by "+*d\inertia\x+" "+*d\inertia\y
		EndIf
		If *f\pushPower
			x.d=*f\pushPower\x*power*delta
			If *attacker\lockedDirection
				x=-x
			EndIf
			y.d=*f\pushPower\y*power*delta
			If *d\movedBy
				locationAdd(*d\movedBy,x,y)
			Else
				*d\movedBy=locationCreate(x,y)
			EndIf
			If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BULLDOZER)
				locationMult(*d\movedBy,#H2H_STANCE_BADGE_BULLDOZER_PUSH_FACTOR,#H2H_STANCE_BADGE_BULLDOZER_PUSH_FACTOR)
			EndIf
			If playerHasBadge(*defender,#H2H_STANCE_BADGE_BULLDOZER)
				locationMult(*d\movedBy,#H2H_STANCE_BADGE_BULLDOZER_RESISTANCE_FACTOR,#H2H_STANCE_BADGE_BULLDOZER_RESISTANCE_FACTOR)
			EndIf
			If playerHasBadge(*attacker,#H2H_STANCE_BADGE_BRUISER)
				locationMult(*d\movedBy,#H2H_STANCE_BADGE_BRUISER_PUSH_FACTOR,#H2H_STANCE_BADGE_BRUISER_PUSH_FACTOR)
			EndIf
;  			Debug "pushed by "+*d\movedBy\x+" "+*d\movedBy\y
		EndIf
		If *f\moveTargetTo
			If *d\movedTo
				set(*d\movedTo,*attacker\position\x,*attacker\position\y)
			Else
				*d\movedTo=locationCreate(*attacker\position\x,*attacker\position\y)
			EndIf
			locationAddloc(*d\movedTo,*f\moveTargetTo)
		EndIf
		If Not *dg
			If frameMovementDeltaNeedCatch(*f) And ListSize(*attacker\hit())>0
				If *attacker\lockedDirection
					set(*attacker\deltaAttack,-*f\movementD\x,
					    				*f\movementD\y)
				Else
					set(*attacker\deltaAttack,*f\movementD\x,
					    			   *f\movementD\y)
				EndIf
			EndIf
		EndIf
	EndIf
EndProcedure

Procedure playerAttack(*attacker.player,*defender.player,delta.d=1)
	If Not *attacker Or Not *defender Or *attacker=*defender
		ProcedureReturn
	EndIf
	playerHurt(*attacker,*defender,*attacker\currentAnimation\frames(*attacker\currentAnimation\index),-999,playerCheckAttackColision(*attacker,*defender),playerGetCurrentSoundMaterial(*attacker),delta)
EndProcedure

Macro playerJoystickDisplay(p,x,y,currentButton)
	joystickDisplay(p\joystickId,x,y,currentButton,p\joystickMap())
EndMacro

Procedure playerRefreshJoystickMap(*p.player)
	For i=0 To ArraySize(*p\joystickMap())
		*p\joystickMap(i)=0
	Next
	*jc.control=*p\joystickControl
	For i=0 To #H2H_CONTROL_EXIT
		If Not controlEmpty(*jc,i)
			*p\joystickMap(controlGet(*jc,i))=i
		EndIf
	Next
EndProcedure

Procedure playerJoystickSet(*p.player,whatButton.i,whatAction.i)
	controlSet(*p\joystickControl,whatAction,whatButton)
	If whatButton<=ArraySize(*p\joystickMap())
		*p\joystickMap(whatButton)=whatAction
	EndIf
EndProcedure

Procedure playerResetJoystickToDefault(*p.player)
	If Not *p
		ProcedureReturn
	EndIf
	controlClear(*p\joystickControl)
	For i=0 To ArraySize(*p\joystickMap())
		*p\joystickMap(i)=0
	Next
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ATTACK,#H2H_CONTROL_ATTACK)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_HEAVY,#H2H_CONTROL_HEAVY)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_SPECIAL,#H2H_CONTROL_SPECIAL)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_NEUTRAL,#H2H_CONTROL_NEUTRAL)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ATTACK_SIDE,#H2H_CONTROL_ATTACK_SIDE)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ATTACK_BACK,#H2H_CONTROL_ATTACK_BACK)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ATTACK_UP,#H2H_CONTROL_ATTACK_UP)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ATTACK_DOWN,#H2H_CONTROL_ATTACK_DOWN)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_DODGE,#H2H_CONTROL_DODGE)
; 	playerJoystickSet(*p,#H2H_JOYSTICK_DEFAULT_DODGE_ALTERNATE,#H2H_ACTION_DODGE)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_JUMP,#H2H_CONTROL_JUMP)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_PARRY,#H2H_CONTROL_PARRY)
; 	playerJoystickSet(*p,#H2H_JOYSTICK_DEFAULT_PARRY_ALTERNATE,#H2H_ACTION_PARRY)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_DASH_LEFT,#H2H_CONTROL_DASH_LEFT)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_DASH_RIGHT,#H2H_CONTROL_DASH_RIGHT)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_ACCEPT,#H2H_CONTROL_ACCEPT)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_CANCEL,#H2H_CONTROL_CANCEL)
	playerJoystickSet(*p,#H2H_CONTROLLER_DEFAULT_EXIT,#H2H_CONTROL_EXIT)
EndProcedure
Procedure playerResetKeyboardToDefault(*p1.player,*p2.player)
	If *p1
		*kc.control=*p1\keyboardControl
		controlSet(*kC,#H2H_CONTROL_LEFT,#H2H_CONTROL_DEFAULT_RIGHT_LEFT)
		controlSet(*kC,#H2H_CONTROL_RIGHT,		#H2H_CONTROL_DEFAULT_RIGHT_RIGHT)
		controlSet(*kC,#H2H_CONTROL_UP,		#H2H_CONTROL_DEFAULT_RIGHT_UP)
		controlSet(*kC,#H2H_CONTROL_DOWN,		#H2H_CONTROL_DEFAULT_RIGHT_DOWN)
		controlSet(*kC,#H2H_CONTROL_ATTACK,	#H2H_CONTROL_DEFAULT_RIGHT_NEUTRAL)
		controlSet(*kC,#H2H_CONTROL_HEAVY,		#H2H_CONTROL_DEFAULT_RIGHT_HEAVY)
		controlSet(*kC,#H2H_CONTROL_SPECIAL,	#H2H_CONTROL_DEFAULT_RIGHT_SPECIAL)
		controlSet(*kC,#H2H_CONTROL_NEUTRAL,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_SIDE,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_BACK,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_UP,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_DOWN,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_JUMP,		#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_PARRY,		#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_DASH_LEFT,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_DASH_RIGHT,	#H2H_CONTROL_EMPTY)
		*p1\jumpWithUp=		#False
		*p1\directionMode=#H2H_PLAYER_DIRECTION_DEFAULT
	EndIf
	If *p2
		*kc.control=*p2\keyboardControl
		controlSet(*kC,#H2H_CONTROL_LEFT,#H2H_CONTROL_DEFAULT_LEFT_LEFT)
		controlSet(*kC,#H2H_CONTROL_RIGHT,		#H2H_CONTROL_DEFAULT_LEFT_RIGHT)
		controlSet(*kC,#H2H_CONTROL_UP,		#H2H_CONTROL_DEFAULT_LEFT_UP)
		controlSet(*kC,#H2H_CONTROL_DOWN,		#H2H_CONTROL_DEFAULT_LEFT_DOWN)
		controlSet(*kC,#H2H_CONTROL_ATTACK,	#H2H_CONTROL_DEFAULT_LEFT_NEUTRAL)
		controlSet(*kC,#H2H_CONTROL_HEAVY,		#H2H_CONTROL_DEFAULT_LEFT_HEAVY)
		controlSet(*kC,#H2H_CONTROL_SPECIAL,	#H2H_CONTROL_DEFAULT_LEFT_SPECIAL)
		controlSet(*kC,#H2H_CONTROL_NEUTRAL,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_SIDE,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_BACK,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_UP,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_ATTACK_DOWN,#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_JUMP,		#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_PARRY,		#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_DASH_LEFT,	#H2H_CONTROL_EMPTY)
		controlSet(*kC,#H2H_CONTROL_DASH_RIGHT,	#H2H_CONTROL_EMPTY)
		*p2\jumpWithUp=		#False
		*p2\directionMode=#H2H_PLAYER_DIRECTION_DEFAULT
	EndIf
EndProcedure
