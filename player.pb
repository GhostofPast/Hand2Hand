#H2H_PLAYER_HIT_SHAKE_AMPLITUDE=6
;--- swishes & land wind
Global Dim *landLightFront.animation(0)
Global Dim *landLightBack.animation(0)
Global Dim *landHeavyFront.animation(0)
Global Dim *landHeavyBack.animation(0)

Enumeration 0
	#H2H_PLAYER_COLOR_MODE_ADAPTATIVE	; Player 2 get alternate if the color is too close to Player 1, by default
	#H2H_PLAYER_COLOR_MODE_ALTERNATIVE	; Player 2 get alternate if its stance has a color
	#H2H_PLAYER_COLOR_MODE_BASIC		; Player 1 always has orange and Player 2 blue
	#H2H_PLAYER_COLOR_MODE_CONTRAST     ; Player 1 is black and player 2 has low color intensity
EndEnumeration
#H2H_PLAYER_COLOR_MODE_DEFAULT=#H2H_PLAYER_COLOR_MODE_ADAPTATIVE

Global playerColorMode=#H2H_PLAYER_COLOR_MODE_DEFAULT

resetGroundLevel()

; for each player
Structure HUD
	pendingDamage.d ; increased by damage, decreased by time
	flicker.d ; when HP is low, defines the red opacity from 0 to 255
	*shift.location	; for trembling everywhere
	*who.player
EndStructure

Enumeration 0
	#H2H_PLAYER_DIRECTION_DYNAMIC 		; Side is player facing ahead, by default
	#H2H_PLAYER_DIRECTION_STATIC_LEFT	; Side is neutral + left
	#H2H_PLAYER_DIRECTION_STATIC_RIGHT	; Side is neutral + right
EndEnumeration

#H2H_PLAYER_DIRECTION_DEFAULT=#H2H_PLAYER_DIRECTION_DYNAMIC

;--- player struct ================================================
Structure player
	id.i
	name.s
	*currentAnimation.animation
	*currentFrame.frame
	sub.f ; for delta time
	frameIndicator.i ; which frame step it is in the current animation
	recovery.d		 ; for when an attacks ends
	
	position.location ; position of the player in the terrain
	;previousPosition.location ; for physics
	deltaMovement.location ; movement set at 0
	deltaAttack.location   ; forced movement through own attacks
	deltaPush.location
	screenPosition.location ; position of the player in the screen
	
	life.i
	maxLife.i
	
	guard.d		; regen increased by endurance
	maxGuard.d	; increased by weight
	guardFreeze.d ; delay when hit before guard regen resume
	regeneratedGuard.d
	
	hitbox.i ; index of the hitbox sprite
	attacking.b ; boolean if is attacking
	color.i		; RGBA
	alternateColor.i ; RGBA
	*keyboardControl.control
	*joystickControl.control
	jumpWithUp.b
	directionMode.b ; by default #H2H_PLAYER_DIRECTION_DYNAMIC
	*pushed.control ; 1= pushed, refreshed each loop, used for joystick only since 0.1.1
	controlEnabled.b
 	*controlState.controlState
	*class.class
	classStanceId.i
	*currentStance.stance
	usesAlternate.i ; true if !=0
	direction.i ;0=facing left, 1=facing right
	lockedDirection.i ; same as direction, but indicates which direction the animation is facing
	displayDebug.i ; if >0 display debug data
	List hit.i()   ; filled with hit players, cleared when finished an attack
	hasHitSomeone.i ; if >0 he it someone before, reset at each animation start
; 	combo.b[#H2H_COMBO_MAX]
; 	comboShake.d[#H2H_COMBO_MAX]
; 	comboSize.d[#H2H_COMBO_MAX]
; 	comboHit.d[#H2H_COMBO_MAX]
; 	comboFlash.d[#H2H_COMBO_MAX]
; 	comboSuccess.d[#H2H_COMBO_MAX]
; 	comboDirection.d[#H2H_COMBO_MAX]
	*combo;b
	*comboShake;d[#H2H_COMBO_MAX]
	*comboSize;d[#H2H_COMBO_MAX]
	*comboHit;d[#H2H_COMBO_MAX]
	*comboFlash;d[#H2H_COMBO_MAX]
	*comboSuccess;d[#H2H_COMBO_MAX]
	*comboDirection;d[#H2H_COMBO_MAX]
	comboCount.b
	comboMax.c ; allocated

	*hud.HUD
	
	regenTick.d ; for Endurence
	regenTotal.i ; reset at round start, also called stamina bar
	gravity.i
	landed.b
	blocked.b ; if true won't benefit from combo shortcut
	caught.b ; if true cannot move, attack or get affected by gravity
	
	yPerturbation.d ; reset to 0 at each new animation, increased by absolute Y received pushes, if too high the player animation is reset
	
	dodge.d ; when >0, will dodge for this amount of frames
	jumpReload.d ; when <0 the player can dodge
	parry.d		 ; when >0 is parrying
	
	;blockAmount.i ; remaining amount of block, if >0 can block
	
	isAI.i ; also indicates the level
	*bot.ai
	feedback.i
	hitMode.i 	; indicates if the player is currently flinched. -1 is none, and >-1 indicates which hit icon is currently used
	tmpHitMode.i; indicates a hit when a frame delay occurs
	hasMoved.b	; tweak for fixing double frame movement
	spawnedWind.b ; so no spawning two times the wind at the same frame
	spawnedProjectile.b ; same principle
	
	joystickId.i ; if -1 then there's no joystick controling this player
	; index : #H2H_JOYSTICK_BUTTON
	; value : #H2H_ACTION
	Array joystickMap.b(#H2H_CONTROL_EXIT)
	
	victories.i ; for round matches
 EndStructure
 
 ;--- damage gadget struct
 Structure damageGadget
	id.i
	*animation.animation
	*ref.animation ; to which animation it is refered for damage hit check
	*player.player
	List *hit()
	sub.d
	frameIndex.i
	frameIndicator.i
	direction.i
	color.i ; can be different than the player
	colorIntensity.i
	*position.location
EndStructure

;--- damage data struct
Structure damageData
	*origin.player
	*target.player
	damage.i
	stun.i
	type.b
	pureProjectile.b
	*hSM.hitSoundMaterial
	*movedBy.location
	*movedTo.location
	*inertia.location ; for movementD
EndStructure

#H2H_DATA_DAMAGEDATA_BASE=$1000
Global DATA_DAMAGEDATA_BASE=#H2H_DATA_DAMAGEDATA_BASE
CompilerIf #H2H_MODE=#H2H_MODE_LOAD
	LoadJSON(0,"data.json")
	*parent=GetJSONMember(JSONValue(0),#H2H_JSON_MEMORY_KEY)
	If *parent
		DATA_DAMAGEDATA_BASE=loadJSONInteger(*parent,"damageData")
	EndIf
	FreeJSON(0)
CompilerEndIf
Global dataDamageDataSize.i=DATA_DAMAGEDATA_BASE*SizeOf(damageData)
Global *dataDamageData=AllocateMemory(dataDamageDataSize,#PB_Memory_NoClear)
Global dataDamageDataIndex=0
Global Dim dataDamageDataPile(7) ; byte indexes of available locations
Global dataDamageDataPileIndex=-1

Declare playerStun(*p.player,stun.i)

Global NewList *allDamageData.damageData()

; Locations will be copied
Procedure.i damageDataAdd(*fromWho.player,*toWho.player,newDamage.i,newStun.i=0,*willBeMovedBy.location=#Null,*kanseiDorifuto.location=#Null,*willBeMovedTo.location=#Null)
	*d.damageData
	If dataDamageDataPileIndex>-1
		If dataDamageDataPile(dataDamageDataPileIndex)<dataDamageDataIndex
			*d=*dataDamageData+dataDamageDataPile(dataDamageDataPileIndex)
		Else
			*d=dataDamageDataPile(dataDamageDataPileIndex)
		EndIf
		dataDamageDataPileIndex-1
	Else
		*d=*dataDamageData+dataDamageDataIndex
		dataDamageDataIndex+SizeOf(damageData)
		If dataDamageDataIndex>=dataDamageDataSize
			Debug "Not enough damage data !"
			*d=AllocateStructure(damageData)
; 			MessageRequester("warning","reallocate damage data")
; 			End
; 			dataDamageDataSize*2
; 			*dataDamageData=ReAllocateMemory(*dataDamageData,dataDamageDataSize,#PB_Memory_NoClear)
		EndIf
	EndIf
	*d\origin=*fromWho
	*d\target=*toWho
	*d\damage=newDamage
	*d\stun=newStun
	If *willBeMovedBy
		*d\movedBy=locationCreate(*willBeMovedBy\x,*willBeMovedBy\y)
	EndIf
	If *willBeMovedTo
		*d\movedTo=locationCreate(*willBeMovedTo\x,*willBeMovedTo\y)
	EndIf
	If *kanseiDorifuto
		*d\inertia=locationCreate(*kanseiDorifuto\x,*kanseiDorifuto\y)
	EndIf
	
	AddElement(*allDamageData())
	*allDamageData()=*d
	
	ProcedureReturn *d
EndProcedure
Declare playerGuardDamage(*p.player,damage.d)

Enumeration 1
	#H2H_AI_LEVEL_EASY
	#H2H_AI_LEVEL_MEDIUM
	#H2H_AI_LEVEL_HARD
	#H2H_AI_LEVEL_INSANE
EndEnumeration

Macro playerGetStance(p)
	p\class\allStances(p\classStanceId)
EndMacro

Macro playerHasBadge(p,what)
	(playerGetStance(p)\badge&what)
EndMacro

Macro playerGetStrength(p)
	(classGetStrength(p\class)+statGetStrength(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetAgility(p)
	(classGetAgility(p\class)+statGetAgility(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetSpeed(p)
	(classGetSpeed(p\class)+statGetSpeed(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetWeight(p)
	(classGetWeight(p\class)+statGetWeight(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetStamina(p)
	(classGetEndurance(p\class)+statGetEndurance(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetLife(p)
	(classGetLife(p\class)+statGetLife(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetCut(p)
	(classGetCut(p\class)+statGetCut(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetPierce(p)
	(classGetPierce(p\class)+statGetPierce(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetBlunt(p)
	(classGetBlunt(p\class)+statGetBlunt(playerGetStance(p)\modificator)+Bool(p\isAI=#H2H_AI_LEVEL_INSANE)*AI_CHEAT_BONUS)
EndMacro
Macro playerGetReach(p)
	classGetReach(p\class)
EndMacro

Macro playerGetParryMargin(p)
	(PLAYER_PARRY_MARGIN_BASE-PLAYER_PARRY_MARGIN_PER_AGILITY*playerGetAgility(p)-PLAYER_PARRY_MARGIN_PER_SPEED*playerGetSpeed(p))
EndMacro
Declare playerHasCommand(*p.player,command.c,justPressed.i=#False)

CompilerIf #H2H_STANCE_BADGE_EVADER_DODGE_SPEED_FACTOR>0
Procedure playerGetDodgeMin(*p.player)
	If playerHasBadge(*p,#H2H_STANCE_BADGE_EVADER)
		ProcedureReturn (PLAYER_DODGE_MARGIN-playerGetAgility(*p)*PLAYER_DODGE_PER_AGILITY)/#H2H_STANCE_BADGE_EVADER_DODGE_SPEED_FACTOR
	EndIf
	ProcedureReturn PLAYER_DODGE_MARGIN-playerGetAgility(*p)*PLAYER_DODGE_PER_AGILITY
EndProcedure
CompilerElse
Macro playerGetDodgeMin(p)
	(PLAYER_DODGE_MARGIN-playerGetAgility(p)*PLAYER_DODGE_PER_AGILITY)
EndMacro
CompilerEndIf

Macro playerGetDodgeMax(p)
	(PLAYER_DODGE_BASE-max(playerGetDodgeMin(p),0))
EndMacro

Macro playerIsDodgeActive(p)
	(p\dodge>playerGetDodgeMin(p) And p\dodge<playerGetDodgeMax(p))
EndMacro

Macro playerGetDodgeReload(p)
	(PLAYER_DODGE_BASE-playerGetAgility(p)*PLAYER_DODGE_RELOAD_PER_AGILITY)
EndMacro

Procedure playerApplyDamage(*d.damageData)
	*p.player=*d\target
	parry=#False
 	If *p\guard>0
		margin=playerGetParryMargin(*p)
		If margin>0
			parry=Bool(*p\parry>=margin)
		Else
			parry=Bool(playerHasCommand(*p,#H2H_CONTROL_PARRY) Or *p\parry>0)
		EndIf
	EndIf
	If *p\life>=PLAYER_HP_BASE And playerHasBadge(*p,#H2H_STANCE_BADGE_WALL)
		*d\damage*#H2H_STANCE_BADGE_WALL_OUTER_FACTOR
	EndIf
	parried=#False
	If parry
		If *d\damage>0
			If Not demoFight
				psound(#H2H_SOUND_ID_BLOCK,*p\screenPosition\x)
			EndIf
			Protected soaked.d=PLAYER_PARRY_DAMAGE_BASE+PLAYER_PARRY_DAMAGE_PER_STRENGTH*playerGetStrength(*p)+PLAYER_PARRY_DAMAGE_PER_AGILITY*playerGetAgility(*p)+PLAYER_PARRY_DAMAGE_PER_SPEED*playerGetSpeed(*p)+PLAYER_PARRY_DAMAGE_PER_WEIGHT*playerGetWeight(*p)
			soaked+PLAYER_PARRY_DAMAGE_PER_STAMINA*playerGetStamina(*p)*PLAYER_PARRY_DAMAGE_PER_LIFE*playerGetLife(*p)
			If playerHasBadge(*p,#H2H_STANCE_BADGE_SMART)
				soaked*#H2H_STANCE_BADGE_SMART_PARRY_FACTOR
				If #H2H_STANCE_BADGE_SMART_PARRY_FACTOR>0
					*p\parry+*d\damage*(2/#H2H_STANCE_BADGE_SMART_PARRY_FACTOR) ; TODO constant
				Else
					*p\parry+*d\damage*2 ; TODO constant
				EndIf
			Else
				*p\parry+*d\damage*2 ; TODO constant
			EndIf
			*d\damage-soaked
			If *d\damage<PLAYER_PARRY_DAMAGE_MIN
				*d\damage=PLAYER_PARRY_DAMAGE_MIN
			EndIf
			parried=#True
			*d\origin\blocked=#True
		EndIf
		*d\stun=0
	EndIf
	If playerHasBadge(*p,#H2H_STANCE_BADGE_SMART) And Not playerIsDodgeActive(*p) And *p\dodge>0
		*d\damage*#H2H_STANCE_BADGE_SMART_DODGE_DAMAGE_FACTOR
	EndIf
	
	If *d\damage>0
		If playerHasBadge(*p,#H2H_STANCE_BADGE_WALL)
			*p\life-*d\damage*#H2H_STANCE_BADGE_WALL_ARMOR_FACTOR
		Else
			*p\life-*d\damage
		EndIf
		If playerHasBadge(*d\origin,#H2H_STANCE_BADGE_SMART)
			*d\origin\guard+*d\damage*#H2H_STANCE_BADGE_SMART_GUARD_FACTOR
			If *d\origin\guard>*d\origin\maxGuard
				*d\origin\guard=*d\origin\maxGuard
			EndIf
		EndIf
	Else
		*d\damage=0
	EndIf
	Select attackDelayMode
		Case #H2H_DELTA_DELAY_MODE_FIX
			If *d\damage>=#H2H_DELTA_DELAY_THRESHOLD
				deltaDelay+#H2H_DELTA_DELAY
			EndIf
			screenShakeAdd(*d\damage*2,*d\damage*2) ; TODO constant
		Case #H2H_DELTA_DELAY_MODE_RELATIVE
			deltaDelay+damage*#H2H_DELTA_DELAY_FACTOR
			screenShakeAdd(*d\damage*2,*d\damage*2) ; TODO constant
	EndSelect
	
	f=0
	If *d\damage>3
		f=*d\damage*2+2 ; TODO constant
	Else
		If *d\damage>0
	 		f=*d\damage+1 ; TODO constant
 		EndIf
 	EndIf
 	If *p\feedback>=50 ; TODO constant
 		f/2
 	EndIf
 	Protected broken.i=#False
 	*p\feedback+f
 	If *d\damage>0 Or parried
 		hitSoundMaterialPlay(*d\hSM,*d\damage,*d\type,*p\screenPosition\x+shiftX)
 	EndIf
 	Protected guardDamageModifier.d=1
 	If playerHasBadge(*d\origin,#H2H_STANCE_BADGE_BULLDOZER)
 		guardDamageModifier*#H2H_STANCE_BADGE_BULLDOZER_GUARD_DAMAGE_FACTOR
 	EndIf
 	If playerHasBadge(*p,#H2H_STANCE_BADGE_WALL)
 		guardDamageModifier*#H2H_STANCE_BADGE_WALL_GUARD_FACTOR
 	EndIf
 	If playerHasBadge(*d\origin,#H2H_STANCE_BADGE_TECHNICIAN) And *d\pureProjectile
 		guardDamageModifier*#H2H_STANCE_BADGE_TECHNICIAN_GUARD_FACTOR
 	EndIf
 	
	If *d\damage>0
		screenShakeAdd(*d\damage,*d\damage)
		*p\hud\pendingDamage+*d\damage
		overboard=*d\damage
		If *p\guard>0
			overboard-*p\guard
			If parry
				broken|playerGuardDamage(*p,max(*d\damage*PLAYER_PARRY_GUARD_COST*guardDamageModifier,PLAYER_PARRY_COST_MIN))
			Else
				broken|playerGuardDamage(*p,*d\damage*guardDamageModifier)
			EndIf
		EndIf
		If overboard>0
			; Added stun cannot make the target having more recovery than 25
			overboard/2
			stun=*d\stun
			*d\stun+min(overboard,5)
			If *d\stun+*p\recovery>PLAYER_STUN_MAX
				*d\stun=max(stun,PLAYER_STUN_MAX-*p\recovery)
			EndIf
		EndIf
	Else
		If parried And PLAYER_PARRY_COST_MIN>0
			broken|playerGuardDamage(*p,PLAYER_PARRY_COST_MIN*guardDamageModifier)
		EndIf
	EndIf
	If *d\stun>0
		playerStun(*p,*d\stun)
		broken|playerGuardDamage(*p,*d\stun*guardDamageModifier)
	EndIf
	If *d\movedBy
		If parry
			locationMult(*d\movedBy,PLAYER_PARRY_PUSH_FACTOR,PLAYER_PARRY_PUSH_FACTOR)
		EndIf
		x=*d\movedBy\x
		y=*d\movedBy\y
		locationAdd(*p\deltaPush,-x,-y)
		If (x>0 And *p\deltaPush\x<0) Or (x<0 And *p\deltaPush\x>0)
			*p\deltaPush\x=0
		EndIf
		If (y>0 And *p\deltaPush\y<0) Or (y<0 And *p\deltaPush\y>0)
			*p\deltaPush\y=0
		EndIf
		locationAdd(*p\position,x,y)
		*p\yPerturbation+Abs(y)
	EndIf
	If *d\inertia
		If parry
			locationMult(*d\inertia,PLAYER_PARRY_PUSH_FACTOR,PLAYER_PARRY_PUSH_FACTOR)
		EndIf
		locationAddLoc(*p\deltaPush,*d\inertia)
	EndIf
	If *d\movedTo
		set(*p\position,*d\movedTo\x,*d\movedTo\y)
		set(*p\deltaMovement)
		set(*p\deltaPush)
		set(*p\deltaAttack)
	EndIf
	;ProcedureReturn ; TEMPORARY
	If broken And Not demoFight
		; TODO get HUD side
		If *p\name="Player 2" XOr player1OnTheLeft
			playPoolSound(*allSoundPool(Str(#H2H_SOUND_ID_GUARD_BREAK)),0)
		Else
			playPoolSound(*allSoundPool(Str(#H2H_SOUND_ID_GUARD_BREAK)),screenSizeX)
		EndIf
	EndIf
EndProcedure

Procedure damageDataDestroy(*dg.damageData)
	If *dg
		; locations data are in read only !
		dataDamageDataPileIndex+1
		If dataDamageDataPileIndex>=ArraySize(dataDamageDataPile())
			ReDim dataDamageDataPile( (ArraySize(dataDamageDataPile())+1)*2 -1)
		EndIf
		If *dg>=*dataDamageData And *dg<*dataDamageData+dataDamageDataSize
			dataDamageDataPile(dataDamageDataPileIndex)=*dg-*dataDamageData
		Else
			dataDamageDataPile(dataDamageDataPileIndex)=*dg
		EndIf
		If *dg\movedBy
			locationDestroy(*dg\movedBy)
		EndIf
		If *dg\movedTo
			locationDestroy(*dg\movedTo)
		EndIf
		If *dg\inertia
			locationDestroy(*dg\inertia)
		EndIf
		*dg\origin=#Null
	EndIf
EndProcedure

Procedure playerApplyDamageAll()
	ForEach *allDamageData()
		playerApplyDamage(*allDamageData())
		damageDataDestroy(*allDamageData())
		DeleteElement(*allDamageData())
	Next
EndProcedure

IncludeFile "group.pb"
Procedure playerFacePoint(*p.player,*where.location)
	If Not *p Or Not *where
		ProcedureReturn
	EndIf
	; center the player
	If *p\position\x+500>*where\x
		*p\direction=0
	EndIf
	If *p\position\x+500<*where\x
		*p\direction=1
	EndIf
EndProcedure

Procedure playerFacePlayer(*p1.player,*p2.player)
	If Not *p1 Or Not *p2
		ProcedureReturn
	EndIf
	If *p1\position\x>*p2\position\x
		*p1\direction=0
	EndIf
	If *p1\position\x<*p2\position\x
		*p1\direction=1
	EndIf
EndProcedure

