Global filler=spriteIndexAdd() ; the bent rectangle to make the bars
Procedure initFiller()
	If Not IsSprite(filler)
		CreateSprite(filler,128,128,#PB_Sprite_AlphaBlending)
		StartDrawing(SpriteOutput(filler))
		DrawingMode(#PB_2DDrawing_AllChannels)
		Box(0,0,1,1,#White)
		StopDrawing()
		TransparentSpriteColor(filler,RGB(1,0,0)) ; won't be able to be colored else. Why ? Because feur
	EndIf
EndProcedure

Enumeration
	#H2H_UI_BAR_TYPE_HP
	#H2H_UI_BAR_TYPE_GUARD
	#H2H_UI_BAR_TYPE_STAMINA
EndEnumeration

Procedure playerGetRegenMax(*p.player)
	; in a procedure because the compiler doesn't like too complex instructions
	ProcedureReturn PLAYER_REGEN_TOTAL_BASE+PLAYER_REGEN_TOTAL_INCREMENT*playerGetStamina(*p)
EndProcedure

;----- guard
Procedure playerGuardRegen(*p.player)
	overboard.d=0
	If *p\guardFreeze>0
; 		Debug *p\name+" frost for "+*p\guardFreeze
		*p\guardFreeze-deltaGlobal
		If *p\guardFreeze<0
			overboard-*p\guardFreeze
			*p\guardFreeze=0
		EndIf
	EndIf
	If *p\guardFreeze<=0
		g.d=((PLAYER_GUARD_PER_SECOND+PLAYER_GUARD_PER_SECOND_PER_ENDURANCE*playerGetStamina(*p))/#H2H_FRAMEPERSECOND)*deltaGlobal+overboard
		If *p\regenTotal<playerGetRegenMax(*p)
			g*PLAYER_GUARD_STAMINA_BONUS
			If playerHasBadge(*p,#H2H_STANCE_BADGE_RESILLIENT)
				g*#H2H_STANCE_BADGE_RESILLIENT_GUARD_FACTOR
			EndIf
		EndIf
		If *p\guard+g>*p\maxGuard
			g=*p\maxGuard-*p\guard
		EndIf
		If *p\regenTotal<playerGetRegenMax(*p)
			*p\regeneratedGuard+g
			If *p\regeneratedGuard>=PLAYER_GUARD_STAMINA_CEIL
				*p\regeneratedGuard-PLAYER_GUARD_STAMINA_CEIL
				*p\regenTotal+1
				If *p\regenTotal>playerGetRegenMax(*p)
					*p\regenTotal=playerGetRegenMax(*p)
				EndIf
			EndIf
		EndIf
		*p\guard+g
	EndIf
EndProcedure

Procedure playerGuardSet(*p.player)
	*p\maxGuard=PLAYER_GUARD_BASE+PLAYER_GUARD_PER_WEIGHT*playerGetWeight(*p)
	If playerHasBadge(*p,#H2H_STANCE_BADGE_SMART)
		*p\maxGuard+#H2H_STANCE_BADGE_SMART_DODGE_GUARD_BONUS*PLAYER_GUARD_PER_WEIGHT
	EndIf
	*p\guard=*p\maxGuard
	*p\guardFreeze=0
	*p\regeneratedGuard=0
EndProcedure

; returns true if just broken
Procedure.i playerGuardDamage(*p.player,damage.d)
	If damage<=0
		ProcedureReturn #False
	EndIf
	Protected broken.i=Bool(*p\guard>0)
	*p\guard-damage
	If *p\guard<-PLAYER_GUARD_BASE
		*p\guard=-PLAYER_GUARD_BASE
	EndIf
	If *p\guard<=0
		ProcedureReturn broken
	Else
		*p\guardFreeze=PLAYER_GUARD_BASE*2.5
	EndIf
	ProcedureReturn #False
EndProcedure

;------ UI
Procedure UIBarDisplay(type.i,x.i,y.i,value.d,max.d,baseColor.i,baseColorIntensity.i,fillColor.i,flipped.i=#False,justFill.i=#False,opacity.i=255,pendingDamage.d=0)
	Protected starter.i
	Protected middle.i
	Protected ender.i
	Protected size.i
	Protected middleScale.d
	Protected widthScale.d
	Protected nbChunk.i
	small=Bool(screenSizeX<1920)
		
	Select type
		Case #H2H_UI_BAR_TYPE_HP
			scale.d=1
			nbChunk=10
			If small
				nbChunk=5
			EndIf
			If max<1
				max=1
			EndIf
			nbMiddle.i=nbChunk-2
			chunkScale.d=1.0/nbChunk
			starter=#H2H_ICON_BAR_START
			middle=#H2H_ICON_BAR_MIDDLE
			ender=#H2H_ICON_BAR_END
			widthScale=value/PLAYER_HP_BASE
			size=64
		Case #H2H_UI_BAR_TYPE_GUARD
			scale.d=0.5
			If PLAYER_GUARD_PER_WEIGHT>0
				nbChunk=4+(max-PLAYER_GUARD_BASE)/PLAYER_GUARD_PER_WEIGHT
			Else
				nbChunk=4+(max-PLAYER_GUARD_BASE)/#H2H_PLAYER_GUARD_PER_WEIGHT
			EndIf
			If small
				scale=0.375
			EndIf
			If max<1
				max=1
			EndIf
			nbMiddle.i=nbChunk-1
			chunkScale.d=1.0/nbChunk
			starter=#H2H_ICON_BAR_START
			middle=#H2H_ICON_GUARD_MIDDLE
			ender=#H2H_ICON_BAR_END
			widthScale=value/max
			If widthScale<0
				widthScale=0
			EndIf
			size=64
		Case #H2H_UI_BAR_TYPE_STAMINA
			scale.d=0.125
; 			Debug "max = "+max
 			nbChunk=max
			If small
				nbChunk/2
			EndIf
			nbMiddle.i=nbChunk-1
			chunkScale.d=1.0/nbChunk
			starter=#H2H_ICON_BAR_START
			middle=#H2H_ICON_BAR_MIDDLE
			ender=#H2H_ICON_BAR_END
			widthScale=value/max
			If widthScale<0
				widthScale=0
			EndIf
			size=64
	EndSelect

	If flipped
		If widthScale>0
			SpriteQuality(#PB_Sprite_NoFiltering)
			ZoomSprite(filler,128,128)
			TransformSprite(filler,0,0,128,0,128,128,0,128)
			s.d=0
			If type=#H2H_UI_BAR_TYPE_GUARD Or type=#H2H_UI_BAR_TYPE_STAMINA
				s=nbChunk*size*widthScale*scale
			EndIf
			If type=#H2H_UI_BAR_TYPE_HP
				s=(nbChunk-1)*size*widthScale*scale
			EndIf
			ZoomSprite(filler,s,size*scale*0.66)
			TransformSprite(filler,	size*scale,0,
					                s+size*scale,0,
					                s,size*scale*0.66,
					                0,size*scale*0.66)
			DisplayTransparentSprite(filler,x,y+size*scale*0.17,opacity,fillColor)
		EndIf
		If Not justFill
			If type=#H2H_UI_BAR_TYPE_GUARD Or type=#H2H_UI_BAR_TYPE_STAMINA
				UIDisplay(ender,x+size*nbChunk*scale,y,baseColor,baseColorIntensity,opacity,#True,scale)
			EndIf
			If type=#H2H_UI_BAR_TYPE_HP
				UIDisplay(ender,x+size*(nbChunk-1)*scale,y,baseColor,baseColorIntensity,opacity,#True,scale)
			EndIf
			dX.d=x
			For i=1 To nbMiddle
				dX+size*scale
				UIDisplay(middle,dX,y,baseColor,baseColorIntensity,opacity,#True,scale)
			Next
			UIDisplay(starter,x,y,baseColor,baseColorIntensity,opacity,#True,scale)
			If type=#H2H_UI_BAR_TYPE_HP
				overboard.d=pendingDamage+value-PLAYER_HP_BASE
				If overboard<=0
					pendingDamage=0
					overboard=0
				Else
					If pendingDamage<0
						pendingDamage=0
						overboard=0
					EndIf
				EndIf
				hatX=0
				If widthScale>1
					hatX=dX+size*scale*0.55+(pendingDamage/max+widthScale-1)*size*scale*(nbChunk-1)
				Else
					hatX=dX+size*scale*0.55+(overboard/max)*size*scale*(nbChunk-1)
				EndIf
				UIDisplay(#H2H_ICON_BAR_HAT,hatX,y,baseColor,baseColorIntensity,opacity,#True,scale)
			EndIf
		EndIf
	Else	
		
		x-size*nbChunk*scale
		If widthScale>0
			SpriteQuality(#PB_Sprite_NoFiltering)
			ZoomSprite(filler,128,128)
			TransformSprite(filler,0,0,128,0,128,128,0,128)
			s.d=0
			If type=#H2H_UI_BAR_TYPE_GUARD Or type=#H2H_UI_BAR_TYPE_STAMINA
				s=nbChunk*size*widthScale*scale
			EndIf
			If type=#H2H_UI_BAR_TYPE_HP
				s=(nbChunk-1)*size*widthScale*scale
			EndIf
			ZoomSprite(filler,s,size*scale*0.66)
			TransformSprite(filler,	-size*scale,0,
					                s-size*scale,0,
					                s,size*scale*0.66,
					                0,size*scale*0.66)
			If type=#H2H_UI_BAR_TYPE_GUARD Or type=#H2H_UI_BAR_TYPE_STAMINA
				DisplayTransparentSprite(filler,x+size*scale*widthScale+(nbChunk+1)*size*(1.0-widthScale)*scale,y+size*scale*0.17+1,opacity,fillColor)
			EndIf
			If type=#H2H_UI_BAR_TYPE_HP
				DisplayTransparentSprite(filler,x+size*scale*widthScale+nbChunk*size*(1.0-widthScale)*scale,y+size*scale*0.17+1,opacity,fillColor)
			EndIf
		EndIf
		If Not justFill
			If type=#H2H_UI_BAR_TYPE_HP
				UIDisplay(starter,x+size*(nbChunk-1)*scale,y,baseColor,baseColorIntensity,opacity,#False,scale)
			EndIf
			If type=#H2H_UI_BAR_TYPE_GUARD Or type=#H2H_UI_BAR_TYPE_STAMINA
				UIDisplay(starter,x+size*nbChunk*scale,y,baseColor,baseColorIntensity,opacity,#False,scale)
			EndIf
			dX.d=x
			For i=1 To nbMiddle
				dX+size*scale
				UIDisplay(middle,dX,y,baseColor,baseColorIntensity,opacity,#False,scale)
			Next
			UIDisplay(ender,x,y,baseColor,baseColorIntensity,opacity,#False,scale)
			If type=#H2H_UI_BAR_TYPE_HP
				overboard.d=pendingDamage+value-PLAYER_HP_BASE
				If overboard<=0
					pendingDamage=0
					overboard=0
				Else
					If pendingDamage<0
						pendingDamage=0
						overboard=0
					EndIf
				EndIf
				If widthScale>1
					UIDisplay(#H2H_ICON_BAR_HAT,x-size*scale*0.55-(pendingDamage/max+widthScale-1)*size*scale*(nbChunk-1),y,baseColor,baseColorIntensity,opacity,#False,scale)
				Else
					UIDisplay(#H2H_ICON_BAR_HAT,x-size*scale*0.55-(overboard/max)*size*scale*(nbChunk-1),y,baseColor,baseColorIntensity,opacity,#False,scale)
				EndIf
			EndIf
		EndIf
	EndIf
EndProcedure

Macro ColorLerpEx(c1,c2,f)
	RGB(Red(c2)*f+Red(c1)*(1-f),Green(c2)*f+Green(c1)*(1-f),Blue(c2)*f+Blue(c1)*(1-f))
EndMacro

Global HUDEnabled=#True
Procedure playerHUDDisplay(*p.player,flipped.i=#False)
	g=max(*p\guard,0)
	Protected small.i=Bool(screenSizeX<1920)
	If *p\hud\shift
		x=*p\hud\shift\x
		y+*p\hud\shift\y
		px=((Random(Abs(x)*2)-Abs(x))/2)*screenShakeForceFactor
		py=((Random(Abs(y)*2)-Abs(y))/2)*screenShakeForceFactor
	EndIf
	y=100
	If small
		y=50
	EndIf
	y+16
	If screenSizeX>=1920
		y+32
	EndIf
	gX=0
	gY=y+64+6
	If screenSizeX<1300
		If flipped
			gX-72*0.375
		EndIf
	Else
		If flipped
			gX-72*0.5
		EndIf
	EndIf
	c.i=playerGetColor(*p)
	i.i=playerGetColorIntensity(*p)
	If Not isPlayerAlive(*p)
		c=colorLerp(c,#Black)
		i=(i+255)/2
	Else
		If *p\feedback>0
			l.d=1.0-1.0/*p\feedback
			If c=#H2H_STANCE_COLOR_LIGHTRED Or c=#H2H_STANCE_COLOR_RED
				c=ColorLerpEx(c,#White,l)
			Else
				c=ColorLerpEx(c,#Red,l)
			EndIf
		EndIf
	EndIf
	orangeBarColor=#Orange
	If *p\feedback>0
		If c=#H2H_STANCE_COLOR_LIGHTRED Or c=#H2H_STANCE_COLOR_RED
			orangeBarColor=RGB(255,127+min(128,*p\feedback**p\feedback**p\feedback),127+min(128,*p\feedback**p\feedback**p\feedback))
		Else
			orangeBarColor=RGB(255,max(0,128-*p\feedback**p\feedback**p\feedback),0)
		EndIf
	EndIf
	
	factor.d=Abs(*p\hud\flicker)/255
	orangeBarColor=RGB(lerp(Red(orangeBarColor),255,factor),lerp(Green(orangeBarColor),0,factor),lerp(Blue(orangeBarColor),0,factor))
	borderColor.i=c
	textColor=c
	If Red(c)+Green(c)+Blue(c)<64
		textColor=RGB(Red(c)+192,Green(c)+192,Blue(c)+192)
	EndIf
	borderColor=colorLerp(c,#Black)
	borderColor=colorLerp(borderColor,#Black)
	borderColor=RGBA(Red(borderColor),Green(borderColor),Blue(borderColor),192)
	Protected rm=playerGetRegenMax(*p)
	guardColor=#Orange
	If *p\parry>0
		guardColor=Color(192,96,64)
	Else
		If *p\guard<*p\maxGuard
			guardColor=Color(192,96,0)
		EndIf
	EndIf
	classLoadIcon(*p\class)
	If *p\class\iconSprite And IsSprite(*p\class\iconSprite)
		If screenSizeX<1600
			ZoomSprite(*p\class\iconSprite,350,350)
			If flipped
				px-100;125
			Else
				px+100;125
			EndIf
			py-100;125
		Else
			ZoomSprite(*p\class\iconSprite,500,500)
			If flipped
				px-100;175
			Else
				px+100;175
			EndIf
			py-150;175
		EndIf
		spriteFlip(*p\class\iconSprite,0)
		spriteFlip(*p\class\iconSprite,flipped)
	EndIf

	If flipped
		If *p\class\iconSprite And IsSprite(*p\class\iconSprite)
			DisplayTransparentSprite(*p\class\iconSprite,px,py)
			DisplayTransparentSprite(*p\class\iconSprite,px,py,i,c)
			If Not isPlayerAlive(*p)
				AffTextBorder("KO",px+SpriteWidth(*p\class\iconSprite)/2-2*#CHAR_SIZE_X*4/2,py+SpriteHeight(*p\class\iconSprite)/2-#CHAR_SIZE_Y*4/2,#Red,192,2,RGB(32,32,32),255,*font32,*font32Border)
			EndIf
		EndIf
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+128,y,PLAYER_HP_BASE,PLAYER_HP_BASE,c,i,c,flipped,#True,128)
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+128,y,*p\life+*p\hud\pendingDamage,*p\maxLife,c,i,#Yellow,flipped,#True)
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+128,y,*p\life,*p\maxLife,c,i,orangeBarColor,flipped,#False,255,*p\hud\pendingDamage)
		UIBarDisplay(#H2H_UI_BAR_TYPE_GUARD,gX+x+128-12,gY-4,g,*p\maxGuard,c,i,guardColor,flipped)
		If *p\regenTotal>=playerGetRegenMax(*p)
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+128-12,gY-10,rm,rm,0,0,#Black,flipped,#True,128)
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+128-12,gY-10,rm-*p\regenTotal,rm,colorLerp(c,#Black),(i+255)/2,#Orange,flipped)
		Else
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+128-12,gY-10,rm-*p\regenTotal,rm,c,i,#Orange,flipped)
		EndIf
		s.s=*p\class\name
		scale.d=1
		If small
			scale=0.75
			If isPlayerAlive(*p)
				AffTextBorder(s,x+128+64,y-16,textColor,i/2,1,borderColor,255)
			Else
				AffTextBorder(s,x+128+64,y-16,textColor,i,1,borderColor,255)
			EndIf
			s2.s=*p\currentStance\name
			If *p\currentStance=*p\class\allStances(0)
				s2=Mid(s2,0,Len(s2)-Len(lsGet("DEFAULT")))
			EndIf
			AffTextBorder(s2,x+128+64+AfftextGetLength(s)+#CHAR_SIZE_X,y-(16*scale),textColor,i,scale,borderColor,255)
		Else
			scale=1
			If isPlayerAlive(*p)
				AffTextBorder(s+" - ",x+128+64,y-16,textColor,i/2,1,borderColor,255)
			Else
				AffTextBorder(s+" - ",x+128+64,y-16,textColor,i,1,borderColor,255)
			EndIf
			AffTextBorder(*p\currentStance\name,x+128+64+AfftextGetLength(s+" - "),y-(16*scale),textColor,i,scale,borderColor,255)
		EndIf
	Else
		If *p\class\iconSprite And IsSprite(*p\class\iconSprite)
			DisplayTransparentSprite(*p\class\iconSprite,px+screenSizeX-SpriteWidth(*p\class\iconSprite),py)
			DisplayTransparentSprite(*p\class\iconSprite,px+screenSizeX-SpriteWidth(*p\class\iconSprite),py,i,c)
			If Not isPlayerAlive(*p)
				AffTextBorder("KO",px+screenSizeX-SpriteWidth(*p\class\iconSprite)/2-2*#CHAR_SIZE_X*4/2,py+SpriteHeight(*p\class\iconSprite)/2-#CHAR_SIZE_Y*4/2,#Red,192,2,RGB(32,32,32),255,*font32,*font32Border)
			EndIf
		EndIf
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+screenSizeX-128,y,PLAYER_HP_BASE,PLAYER_HP_BASE,c,i,c,#False,#True,128)
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+screenSizeX-128,y,*p\life+*p\hud\pendingDamage,*p\maxLife,c,i,#Yellow,#False,#True)
		UIBarDisplay(#H2H_UI_BAR_TYPE_HP,x+screenSizeX-128,y,*p\life,*p\maxLife,c,i,orangeBarColor,#False,#False,255,*p\hud\pendingDamage)
		UIBarDisplay(#H2H_UI_BAR_TYPE_GUARD,gX+x+screenSizeX-128+20,gY-4,g,*p\maxGuard,c,i,guardColor)
		If *p\regenTotal>=playerGetRegenMax(*p)
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+screenSizeX-128+8,gY-10,rm,rm,0,0,#Black,#False,#True,128)
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+screenSizeX-128+8,gY-10,rm-*p\regenTotal,rm,colorLerp(c,#Black),(i+255)/2,#Orange)
		Else
			UIBarDisplay(#H2H_UI_BAR_TYPE_STAMINA,x+screenSizeX-128+8,gY-10,rm-*p\regenTotal,rm,c,i,#Orange)
		EndIf
		s.s=*p\class\name
		scale.d=1
		If small
			scale=0.75
			s2.s=*p\currentStance\name
			If *p\currentStance=*p\class\allStances(0)
				s2=Mid(s2,0,Len(s2)-Len(lsGet("DEFAULT"))-1)
			EndIf
			If isPlayerAlive(*p)
				AffTextBorder(s,x+screenSizeX-128-AfftextGetLength(s)-64,y-16,textColor,i/2,1,borderColor,255)
			Else
				AffTextBorder(s,x+screenSizeX-128-AfftextGetLength(s)-64,y-16,textColor,i,1,borderColor,255)
			EndIf
 			AffTextBorder(s2,x+screenSizeX-128-AfftextGetLength(s)-AfftextGetLength(s2)*scale-#CHAR_SIZE_X-64,y-(16*scale),textColor,i,scale,borderColor,255)
		Else
			scale=1
			If isPlayerAlive(*p)
				AffTextBorder(" - "+s,x+screenSizeX-128-20-AfftextGetLength(" - "+s)-64,y-16,textColor,i/2,1,borderColor,255)
			Else
				AffTextBorder(" - "+s,x+screenSizeX-128-20-AfftextGetLength(" - "+s)-64,y-16,textColor,i,1,borderColor,255)
			EndIf
			AffTextBorder(*p\currentStance\name,x+screenSizeX-128-20-AfftextGetLength(s+" - "+*p\currentStance\name)-64,y-16,textColor,i,scale,borderColor,255)
		EndIf
	EndIf
	If *p\class\iconSprite And IsSprite(*p\class\iconSprite)
		ZoomSprite(*p\class\iconSprite,#PB_Default,#PB_Default)
	EndIf
EndProcedure

; shadow sprite & hitboxSprite global moved before initBasicSprite()
Procedure createHitBoxSprite()
	If Not hitBoxSprite
		hitBoxSprite=spriteIndex
		spriteIndex=spriteIndex+1
	EndIf
	If Not IsSprite(hitBoxSprite)
			CreateSprite(hitBoxSprite,#HITBOX_SIZE,#HITBOX_SIZE,#PB_Sprite_PixelCollision)
		If StartDrawing(SpriteOutput(hitBoxSprite))=0
			End
		EndIf
		Circle(#HITBOX_SIZE/2,#HITBOX_SIZE/2,#HITBOX_SIZE/2,RGB(255,0,0))
		StopDrawing()
	EndIf
	ProcedureReturn hitBoxSprite
EndProcedure

Procedure createShadowSprite()
	If shadowSprite=0
		shadowSprite=spriteIndex
		spriteIndex+1
	EndIf
	If Not IsSprite(shadowSprite)
		CreateSprite(shadowSprite,#H2H_SHADOW_WIDTH,#H2H_SHADOW_HEIGHT)
		If StartDrawing(SpriteOutput(shadowSprite))=0
			End
		EndIf
		DrawingMode(#PB_2DDrawing_AllChannels)
		For i=2 To 10
			Ellipse(#H2H_SHADOW_WIDTH/2,#H2H_SHADOW_HEIGHT/2,#H2H_SHADOW_WIDTH/i,#H2H_SHADOW_HEIGHT/i,RGBA(21-i*2,21-i*2,21-i*2,128-i*10))
		Next
		StopDrawing()
	EndIf
	ProcedureReturn shadowSprite
EndProcedure

Declare playerSetClass(*p.player,*newClass.class,stanceId.i)

#H2H_DATA_PLAYER_BASE=$2 ; increase if needed
Global DATA_PLAYER_BASE=#H2H_DATA_PLAYER_BASE
CompilerIf #H2H_MODE=#H2H_MODE_LOAD
	LoadJSON(0,"data.json")
	*parent=GetJSONMember(JSONValue(0),#H2H_JSON_MEMORY_KEY)
	If *parent
		DATA_PLAYER_BASE=loadJSONInteger(*parent,"player")
	EndIf
	FreeJSON(0)
CompilerEndIf
Global dataPlayerSize.i=#H2H_DATA_PLAYER_BASE*SizeOf(player)
Global *dataPlayer=AllocateMemory(dataPlayerSize)
Global dataPlayerIndex=0
Global Dim dataPlayerPile(7) ; byte indexes of available locations
Global dataPlayerPileIndex=-1
Procedure.i playerDataGive()
	If dataPlayerPileIndex>-1
		dataPlayerPileIndex-1
		If dataPlayerPile(dataPlayerPileIndex+1)<dataPlayerSize
			ProcedureReturn *dataPlayer+dataPlayerPile(dataPlayerPileIndex+1)
		EndIf
		ProcedureReturn dataPlayerPile(dataPlayerPileIndex+1)
	EndIf

	If dataPlayerindex>=DATA_PLAYER_BASE
		Debug "Not enough players !"
		ProcedureReturn AllocateStructure(player)
; 		MessageRequester("H2H Error","Not enough players !")
; 		End
	EndIf
	Debug "created player "+dataPlayerIndex
	dataPlayerIndex+1
	ProcedureReturn *dataPlayer+(dataPlayerIndex-1)*SizeOf(player)
EndProcedure

Procedure playerDestroyEx(*p.player)
	If *p
		dataPlayerPileIndex+1
		If dataPlayerPileIndex>=ArraySize(dataPlayerPile())
			ReDim dataPlayerPile( (ArraySize(dataPlayerPile())+1)*2 -1)
		EndIf
		If *p>*dataPlayer And *p<*dataPlayer+dataPlayerSize
			dataPlayerPile(dataPlayerPileIndex)=*p-*dataPlayer
		Else
			dataPlayerPile(dataPlayerPileIndex)=*p
		EndIf
	EndIf
EndProcedure

Macro playerDestroy(p)
	playerDestroyEx(p):p=0
EndMacro

Procedure playerComboReallocate(*p.player)
	If Not *p\comboMax
		*p\comboMax=#H2H_COMBO_MAX
		*p\combo=AllocateMemory(*p\comboMax);b
		*p\comboShake=AllocateMemory(*p\comboMax<<3);d
		*p\comboSize=AllocateMemory(*p\comboMax<<3);d
		*p\comboHit=AllocateMemory(*p\comboMax<<3);d
		*p\comboFlash=AllocateMemory(*p\comboMax<<3);d
		*p\comboSuccess=AllocateMemory(*p\comboMax<<3);d
		*p\comboDirection=AllocateMemory(*p\comboMax<<3);d
	Else
		*p\comboMax*2
		*p\combo=ReAllocateMemory(*p\combo,*p\comboMax);b
		*p\comboShake=ReAllocateMemory(*p\comboShake,*p\comboMax<<3);d
		*p\comboSize=ReAllocateMemory(*p\comboSize,*p\comboMax<<3);d
		*p\comboHit=ReAllocateMemory(*p\comboHit,*p\comboMax<<3);d
		*p\comboFlash=ReAllocateMemory(*p\comboFlash,*p\comboMax<<3);d
		*p\comboSuccess=ReAllocateMemory(*p\comboSuccess,*p\comboMax<<3);d
		*p\comboDirection=ReAllocateMemory(*p\comboDirection,*p\comboMax<<3);d
	EndIf
EndProcedure
Macro playerCombo(who,what)
	PeekB(who\combo+what)
EndMacro
Macro playerComboShake(who,what)
	PeekD(who\comboShake+(what<<3))
EndMacro
Macro playerComboSize(who,what)
	PeekD(who\comboSize+(what<<3))
EndMacro
Macro playerComboHit(who,what)
	PeekD(who\comboHit+(what<<3))
EndMacro
Macro playerComboFlash(who,what)
	PeekD(who\comboFlash+(what<<3))
EndMacro
Macro playerComboSuccess(who,what)
	PeekD(who\comboSuccess+(what<<3))
EndMacro
Macro playerComboDirection(who,what)
	PeekD(who\comboDirection+(what<<3))
EndMacro

Macro playerComboSet(who,what,v)
	PokeB(who\combo+what,v)
EndMacro
Macro playerComboShakeSet(who,what,v)
	PokeD(who\comboShake+(what<<3),v)
EndMacro
Macro playerComboSizeSet(who,what,v)
	PokeD(who\comboSize+(what<<3),v)
EndMacro
Macro playerComboHitSet(who,what,v)
	PokeD(who\comboHit+(what<<3),v)
EndMacro
Macro playerComboFlashSet(who,what,v)
	PokeD(who\comboFlash+(what<<3),v)
EndMacro
Macro playerComboSuccessSet(who,what,v)
	PokeD(who\comboSuccess+(what<<3),v)
EndMacro
Macro playerComboDirectionSet(who,what,v)
	PokeD(who\comboDirection+(what<<3),v)
EndMacro

Procedure playerCreate(*p.player,name.s,color.i,*control.control,*newClass.class,mirror=0)
	Static idCount.i=0
	If Not *p
		*p=playerDataGive()
	EndIf
	*p\id=idCount
	idCount=idCount+1
	*p\name=name
	*p\frameIndicator=1
	set(*p\position)
	set(*p\deltaMovement)
	set(*p\deltaAttack)
	; Hitbox creation
	*p\hitbox=createHitBoxSprite()
	createShadowSprite()
	*p\attacking=0
	*p\color=color
	*p\keyboardControl=*control
	*p\pushed=controlcreate() ; still in use for joystick until future update
	controlClear(*p\pushed,#False,0)
	*p\joystickControl=controlcreate()
	*p\controlState=controlStateCreate()
	*p\currentAnimation=animationDataGive()
	*p\direction=0
	*p\displayDebug=-1
	NewList *p\hit.i()
	*p\comboCount=0
	*p\hud=AllocateStructure(HUD)
	ClearStructure(*p\hud,HUD)
	*p\hud\who=*p
	gravity=0
	*p\isAI=0
	playerSetClass(*p,*newClass,0)
; 	If IsJoy(*p\id)
		*p\joystickId=*p\id
; 	Else
; 		*p\joystickId=-1
; 	EndIf
	*p\hitMode=-1
	*p\tmpHitMode=-1
	*p\controlEnabled=#True
	Dim *p\joystickMap(32)
	playerComboReallocate(*p)
	For i=0 To #H2H_COMBO_MAX
		playerComboSizeSet(*p,i,1.0)
	Next
	ProcedureReturn *p
EndProcedure

Declare playerResetLife(*p.player)
Declare playerSetStance(*p.player,what.i=0)

Procedure playerSetClass(*p.player,*newClass.class,stanceId.i)
	If Not *p
		ProcedureReturn
	EndIf
	If Not *newClass
		ProcedureReturn
	EndIf
	If *p\class
		*p\class\playerCount-1
	EndIf
	If *p\class<>*newClass
		*p\class=*newClass
		*p\class\playerCount+1
		animationCopy(*p\currentAnimation,playerGetIdle(*p))
	EndIf
	CompilerIf #H2H_MODE=#H2H_MODE_SAVE
		Debug "Set "+*p\name+" to "+*newClass\name
	CompilerEndIf
	playerSetStance(*p,stanceId)
	playerResetLife(*p)
	playerGuardSet(*p)
	*p\gravity=1
EndProcedure

; Unused, why ?
; Macro playerMove(p,newX,newY)
; 	set(p\position,newX,newY)
; EndMacro

Macro playerHasPressed(p,what)
	Bool(p\controlEnabled And (controlHasPressed(p\keyboardControl,what) Or controlGet(p\pushed,what)))
EndMacro
Macro playerHasJustPressed(p,what)
	Bool(p\controlEnabled And (controlJustPressed(p\keyboardControl,what) Or controlGet(p\pushed,what)=1))
EndMacro
Macro playerHasReleased(p,what)
	Bool(p\controlEnabled And (controlHasReleased(p\keyboardControl,what))
EndMacro

Procedure.i playerHasCommand(*p.player,command.c,justPressed.i=#False)
	If justPressed
		Select command
; 			Case #H2H_CONTROL_LEFT
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_LEFT))
; 			Case #H2H_CONTROL_RIGHT
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_RIGHT))
; 			Case #H2H_CONTROL_UP
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_UP))
; 			Case #H2H_CONTROL_DOWN
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_DOWN))
; 			Case #H2H_CONTROL_ATTACK
; 				Debug *p\name+" attack check "+Str(controlGet(*p\pushed,what))
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_ATTACK))
; 			Case #H2H_CONTROL_HEAVY
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_HEAVY))
; 			Case #H2H_CONTROL_SPECIAL
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL))
			Case #H2H_CONTROL_NEUTRAL
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_NEUTRAL) Or (playerHasJustPressed(*p,#H2H_CONTROL_ATTACK) And Not playerHasPressed(*p,#H2H_CONTROL_LEFT) And Not playerHasPressed(*p,#H2H_CONTROL_RIGHT) And Not playerHasPressed(*p,#H2H_CONTROL_UP) And Not playerHasPressed(*p,#H2H_CONTROL_DOWN)))
			Case #H2H_CONTROL_ATTACK_SIDE
				If playerHasJustPressed(*p,#H2H_CONTROL_ATTACK)
					If Not *p\isAI 	
						Select *p\directionMode
							Case #H2H_PLAYER_DIRECTION_STATIC_LEFT
								ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_LEFT)
							Case #H2H_PLAYER_DIRECTION_STATIC_RIGHT
								ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_RIGHT)
							Default
								ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
						EndSelect
					Else
						ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
					EndIf
				EndIf
				ProcedureReturn playerHasJustPressed(*p,#H2H_CONTROL_ATTACK_SIDE)
			Case #H2H_CONTROL_ATTACK_BACK
				If playerHasJustPressed(*p,#H2H_CONTROL_ATTACK)
					If Not *p\isAI
						Select *p\directionMode
							Case #H2H_PLAYER_DIRECTION_STATIC_LEFT
								ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_RIGHT)
							Case #H2H_PLAYER_DIRECTION_STATIC_RIGHT
								ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_LEFT)
							Default
								ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)))
						EndSelect
					Else
						ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
					EndIf
				EndIf
				ProcedureReturn playerHasJustPressed(*p,#H2H_CONTROL_ATTACK_BACK)
			Case #H2H_CONTROL_ATTACK_UP
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_ATTACK_UP) Or (playerHasJustPressed(*p,#H2H_CONTROL_ATTACK) And playerHasJustPressed(*p,#H2H_CONTROL_UP)))
			Case #H2H_CONTROL_ATTACK_DOWN
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_ATTACK_DOWN) Or (playerHasJustPressed(*p,#H2H_CONTROL_ATTACK) And playerHasJustPressed(*p,#H2H_CONTROL_DOWN)))
			Case #H2H_CONTROL_DODGE
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_DODGE) Or (Bool(playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL) And Not playerHasPressed(*p,#H2H_CONTROL_LEFT) And Not playerHasPressed(*p,#H2H_CONTROL_RIGHT) And Not playerHasPressed(*p,#H2H_CONTROL_UP) And Not playerHasPressed(*p,#H2H_CONTROL_DOWN))))
			Case #H2H_CONTROL_JUMP
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_JUMP) Or (playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasJustPressed(*p,#H2H_CONTROL_UP)))
			Case #H2H_CONTROL_PARRY
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_PARRY) Or (playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasJustPressed(*p,#H2H_CONTROL_DOWN))); And Not playerHasPressed(*p,left) And Not playerHasPressed(*p,right) And Not playerHasPressed(*p,up))
			Case #H2H_CONTROL_DASH_LEFT
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_DASH_LEFT) Or (playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasJustPressed(*p,#H2H_CONTROL_LEFT)))
			Case #H2H_CONTROL_DASH_RIGHT
				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_DASH_RIGHT) Or (playerHasJustPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasJustPressed(*p,#H2H_CONTROL_RIGHT)))
; 			Case #H2H_CONTROL_ACCEPT
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_ACCEPT))
; 			Case #H2H_CONTROL_CANCEL
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_CANCEL))
; 			Case #H2H_CONTROL_EXIT
; 				ProcedureReturn Bool(playerHasJustPressed(*p,#H2H_CONTROL_EXIT))
		EndSelect
		ProcedureReturn Bool(playerHasJustPressed(*p,command))
	EndIf
	Select command
; 		Case #H2H_CONTROL_LEFT
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_LEFT))
; 		Case #H2H_CONTROL_RIGHT
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_RIGHT))
; 		Case #H2H_CONTROL_UP
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_UP))
; 		Case #H2H_CONTROL_DOWN
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_DOWN))
; 		Case #H2H_CONTROL_ATTACK
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_ATTACK))
; 		Case #H2H_CONTROL_HEAVY
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_HEAVY))
; 		Case #H2H_CONTROL_SPECIAL
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_SPECIAL))
		Case #H2H_CONTROL_NEUTRAL
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_NEUTRAL) Or (playerHasPressed(*p,#H2H_CONTROL_ATTACK) And Not playerHasPressed(*p,#H2H_CONTROL_LEFT) And Not playerHasPressed(*p,#H2H_CONTROL_RIGHT) And Not playerHasPressed(*p,#H2H_CONTROL_UP) And Not playerHasPressed(*p,#H2H_CONTROL_DOWN)))
		Case #H2H_CONTROL_ATTACK_SIDE
			If playerHasPressed(*p,#H2H_CONTROL_ATTACK)
				If Not *p\isAI
					Select *p\directionMode
						Case #H2H_PLAYER_DIRECTION_STATIC_LEFT
							ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_LEFT)
						Case #H2H_PLAYER_DIRECTION_STATIC_RIGHT
							ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_RIGHT)
						Default
							ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
					EndSelect
				Else
					ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
				EndIf
			EndIf
			ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_ATTACK_SIDE)
		Case #H2H_CONTROL_ATTACK_BACK
			If playerHasPressed(*p,#H2H_CONTROL_ATTACK)
				If Not *p\isAI
					Select *p\directionMode
						Case #H2H_PLAYER_DIRECTION_STATIC_LEFT
							ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_RIGHT)
						Case #H2H_PLAYER_DIRECTION_STATIC_RIGHT
							ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_LEFT)
						Default
							ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)))
					EndSelect
				Else
					ProcedureReturn Bool((Not *p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_LEFT)) Or (*p\lockedDirection And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
				EndIf
			EndIf
			ProcedureReturn playerHasPressed(*p,#H2H_CONTROL_ATTACK_BACK)
		Case #H2H_CONTROL_ATTACK_UP
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_ATTACK_UP) Or (playerHasPressed(*p,#H2H_CONTROL_ATTACK) And playerHasPressed(*p,#H2H_CONTROL_UP)))
		Case #H2H_CONTROL_ATTACK_DOWN
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_ATTACK_DOWN) Or (playerHasPressed(*p,#H2H_CONTROL_ATTACK) And playerHasPressed(*p,#H2H_CONTROL_DOWN)))
		Case #H2H_CONTROL_DODGE
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_DODGE) Or (Bool(playerHasPressed(*p,#H2H_CONTROL_SPECIAL) And Not playerHasPressed(*p,#H2H_CONTROL_LEFT) And Not playerHasPressed(*p,#H2H_CONTROL_RIGHT) And Not playerHasPressed(*p,#H2H_CONTROL_UP) And Not playerHasPressed(*p,#H2H_CONTROL_DOWN))))
		Case #H2H_CONTROL_JUMP
;  				Debug *p\name+" "+playerHasPressed(*p,#H2H_CONTROL_JUMP)+" "+playerHasPressed(*p,#H2H_CONTROL_SPECIAL)+" "+playerHasPressed(*p,#H2H_CONTROL_UP)
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_JUMP) Or (playerHasPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasPressed(*p,#H2H_CONTROL_UP)))
		Case #H2H_CONTROL_PARRY
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_PARRY) Or (playerHasPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasPressed(*p,#H2H_CONTROL_DOWN)))
		Case #H2H_CONTROL_DASH_LEFT
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_DASH_LEFT) Or (playerHasPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasPressed(*p,#H2H_CONTROL_LEFT)))
		Case #H2H_CONTROL_DASH_RIGHT
			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_DASH_RIGHT) Or (playerHasPressed(*p,#H2H_CONTROL_SPECIAL) And playerHasPressed(*p,#H2H_CONTROL_RIGHT)))
; 		Case #H2H_CONTROL_ACCEPT
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_ACCEPT))
; 		Case #H2H_CONTROL_CANCEL
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_CANCEL))
; 		Case #H2H_CONTROL_EXIT
; 			ProcedureReturn Bool(playerHasPressed(*p,#H2H_CONTROL_EXIT))
	EndSelect
	ProcedureReturn playerHasPressed(*p,command)
EndProcedure

Procedure playerCheckKey(*player.player,inBattle=#False)
	If *player\joystickId<0 Or Not *player\controlEnabled;Or Not IsJoy(*p\joystickId)
;  		Debug *p\name+" no joystick"
		ProcedureReturn
	EndIf
	; 	id=*p\joystickId+1
	id=*player\joystickId
;  	Debug *p\name+" joystick "+id
	*c.control=*player\joystickControl
	*p.control=*player\pushed
	;{
	touched=0
	j=Bool(JoyPushed(id,controlGet(*c,#H2H_CONTROL_ATTACK)))
; 	Debug *player\name+" attack "+j
	controlGet(*p,#H2H_CONTROL_ATTACK)+j
	controlGet(*p,#H2H_CONTROL_ATTACK)*j
; 	Debug JoyX(id)
	j=Bool(JoyX(id,0)<-CONTROLLER_SENSITIVITY)
	controlGet(*p,#H2H_CONTROL_LEFT)+j
	controlGet(*p,#H2H_CONTROL_LEFT)*j
	j=Bool(JoyX(id,0)>CONTROLLER_SENSITIVITY)
	controlGet(*p,#H2H_CONTROL_RIGHT)+j
	controlGet(*p,#H2H_CONTROL_RIGHT)*j
	j=Bool(JoyY(id,0)<-CONTROLLER_SENSITIVITY)
	controlGet(*p,#H2H_CONTROL_UP)+j
	controlGet(*p,#H2H_CONTROL_UP)*j
	j=Bool(JoyY(id,0)>CONTROLLER_SENSITIVITY)
	controlGet(*p,#H2H_CONTROL_DOWN)+j
	controlGet(*p,#H2H_CONTROL_DOWN)*j
	j=JoyPushed(id,controlGet(*c,#H2H_CONTROL_HEAVY))
	controlGet(*p,#H2H_CONTROL_HEAVY)+j
	controlGet(*p,#H2H_CONTROL_HEAVY)*j
	j=JoyPushed(id,controlGet(*c,#H2H_CONTROL_SPECIAL))
	controlGet(*p,#H2H_CONTROL_SPECIAL)+j
	controlGet(*p,#H2H_CONTROL_SPECIAL)*j
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_NEUTRAL))
		t=controlGet(*p,#H2H_CONTROL_NEUTRAL)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_NEUTRAL)=t
	Else
		controlGet(*p,#H2H_CONTROL_NEUTRAL)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_ATTACK_SIDE))
		t=controlGet(*p,#H2H_CONTROL_ATTACK_SIDE)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_ATTACK_SIDE)=t
	Else
		controlGet(*p,#H2H_CONTROL_ATTACK_SIDE)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_ATTACK_BACK))
		t=controlGet(*p,#H2H_CONTROL_ATTACK_BACK)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_ATTACK_BACK)=t
	Else
		controlGet(*p,#H2H_CONTROL_ATTACK_BACK)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_ATTACK_UP))
		t=controlGet(*p,#H2H_CONTROL_ATTACK_UP)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_ATTACK_UP)=t
	Else
		controlGet(*p,#H2H_CONTROL_ATTACK_UP)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_ATTACK_DOWN))
		t=controlGet(*p,#H2H_CONTROL_ATTACK_DOWN)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_ATTACK_DOWN)=t
	Else
		controlGet(*p,#H2H_CONTROL_ATTACK_DOWN)=0
	EndIf
	If Bool(JoyPushed(id,controlGet(*c,#H2H_CONTROL_DODGE)) Or (Not controlGet(*p,#H2H_CONTROL_ATTACK) And Not controlGet(*p,#H2H_CONTROL_HEAVY) And controlGet(*p,#H2H_CONTROL_SPECIAL) And Not controlGet(*p,#H2H_CONTROL_UP) And Not controlGet(*p,#H2H_CONTROL_DOWN) And Not controlGet(*p,#H2H_CONTROL_LEFT) And Not controlGet(*p,#H2H_CONTROL_DOWN)))
		t=controlGet(*p,#H2H_CONTROL_DODGE)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_DODGE)=t
	Else
		controlGet(*p,#H2H_CONTROL_DODGE)=0
	EndIf
	controlGet(*p,#H2H_CONTROL_JUMP)=Bool(JoyPushed(id,controlGet(*c,#H2H_CONTROL_JUMP)) Or (*player\jumpWithUp And inBattle And controlget(*p,#H2H_CONTROL_UP)=1) Or (Not controlGet(*p,#H2H_CONTROL_ATTACK) And Not controlGet(*p,#H2H_CONTROL_HEAVY) And controlGet(*p,#H2H_CONTROL_SPECIAL) And controlGet(*p,#H2H_CONTROL_UP) And Not controlGet(*p,#H2H_CONTROL_DOWN) And Not controlGet(*p,#H2H_CONTROL_LEFT) And Not controlGet(*p,#H2H_CONTROL_DOWN)))
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_PARRY))
		t=controlGet(*p,#H2H_CONTROL_PARRY)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_PARRY)=t
	Else
		controlGet(*p,#H2H_CONTROL_PARRY)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_DASH_LEFT))
		t=controlGet(*p,#H2H_CONTROL_DASH_LEFT)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_DASH_LEFT)=t
	Else
		controlGet(*p,#H2H_CONTROL_DASH_LEFT)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_DASH_RIGHT))
		t=controlGet(*p,#H2H_CONTROL_DASH_RIGHT)+1
		controlClear(*p,#False,0)
		controlGet(*p,#H2H_CONTROL_DASH_RIGHT)=t
	Else
		controlGet(*p,#H2H_CONTROL_DASH_RIGHT)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_ACCEPT))
		controlGet(*p,#H2H_CONTROL_ACCEPT)+1
	Else
		controlGet(*p,#H2H_CONTROL_ACCEPT)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_CANCEL))
		controlGet(*p,#H2H_CONTROL_CANCEL)+1
	Else
		controlGet(*p,#H2H_CONTROL_CANCEL)=0
	EndIf
	If JoyPushed(id,controlGet(*c,#H2H_CONTROL_EXIT))
		controlGet(*p,#H2H_CONTROL_EXIT)+1
	Else
		controlGet(*p,#H2H_CONTROL_EXIT)=0
	EndIf
; 	If controlGet(*p,#H2H_CONTROL_ATTACK)
; 		Debug "attack set to "+controlGet(*p,#H2H_CONTROL_ATTACK)
; 	EndIf
	;}
EndProcedure

Procedure.i playerComboGetId(*p.player)
	Select *p\currentAnimation\animationType
		Case #H2H_ANIMATIONTYPE_NEUTRAL
			ProcedureReturn #H2H_COMBO_NEUTRAL
		Case #H2H_ANIMATIONTYPE_NSIDE
			ProcedureReturn #H2H_COMBO_NSIDE
		Case #H2H_ANIMATIONTYPE_NUP
			ProcedureReturn #H2H_COMBO_NUP
		Case #H2H_ANIMATIONTYPE_NBACK
			ProcedureReturn #H2H_COMBO_NBACK
		Case #H2H_ANIMATIONTYPE_NDOWN
			ProcedureReturn #H2H_COMBO_NDOWN
		Case #H2H_ANIMATIONTYPE_HEAVY
			ProcedureReturn #H2H_COMBO_HEAVY
	EndSelect
; 	Debug "unkown combo id !"
	ProcedureReturn 0
EndProcedure

Procedure playerClearKey(*p.player)
	controlClear(*p\pushed,#True,0)
	*p\controlState\jump=0
	*p\controlState\keep=0
	*p\controlState\pushed=0
EndProcedure

Macro playerGetAnimationIndex(p)
	animationIndex(p\currentAnimation)
EndMacro

Macro playerGetCurrentFrame(p)
	p\currentFrame
EndMacro

Procedure playerApplyMovement(*p.player)
	If *p\currentFrame\movement
		If *p\lockedDirection
			locationAdd(*p\position,-*p\currentFrame\movement\x,*p\currentFrame\movement\y)
		Else
			locationAdd(*p\position,*p\currentFrame\movement\x, *p\currentFrame\movement\y)
		EndIf
; 		Debug "moved y by "+*p\currentFrame\movement\y
		*p\hasMoved=1
	EndIf
EndProcedure

Declare playerResetAnimationTo(*who.player,*what.animation)

Procedure.d playerRecoveryCompute(*p.player)
	ProcedureReturn *p\currentAnimation\recovery/(1.0+playerGetAgility(*p)*PLAYER_RECOVERY_AGILITY_FACTOR)
EndProcedure

Procedure.d playerRecovery(*p.player)
	;	Protected rec=(*p\currentAnimation\recovery*10)/(10+getAgility(*p)*3) ; old formula
	Protected rec.d=playerRecoveryCompute(*p)
	If rec>0
		If playerHasBadge(*p,#H2H_STANCE_BADGE_NERVOUS)
			rec*#H2H_STANCE_BADGE_NERVOUS_RECOVERY_FACTOR
		EndIf
		playerResetAnimationTo(*p,playerGetIdle(*p))
		*p\recovery+rec
	EndIf
	ProcedureReturn rec
EndProcedure

Procedure playerDisplayClassIconCrop(*p.player,x.i,y.i,mirror.i=0,color=0,intensity.i=128)
	If *p And *p\class
		classDisplayIconCroped(*p\class,x,y,mirror,color,intensity,255,RGB(32,32,32))
	EndIf
EndProcedure

Macro playerComboReset(p)
	FillMemory(p\combo,p\comboMax):p\comboCount=0
EndMacro

Procedure playerResetLife(*p.player)
	*p\maxLife=PLAYER_HP_BASE+playerGetLife(*p)*PLAYER_HP_BONUS
	*p\life=*p\maxLife
	*p\regenTotal=0
	*p\hud\pendingDamage=0
EndProcedure

Procedure playerReset(*p.player,x.i)
	If *p
		set(*p\position,x,#GROUND_LEVEL)
		set(*p\deltaAttack)
		set(*p\deltaMovement)
		set(*p\deltaPush)
		If Not *p\currentAnimation
			*p\currentAnimation=AllocateStructure(animation)
		EndIf
		playerResetAnimationTo(*p,playerGetSpawn(*p))
		playerResetLife(*p)
		*p\feedback=0
		classLoadIconCroped(*p\class)
		playerComboReset(*p)
		playerClearKey(*p)
		playerGuardSet(*p)
		*p\dodge=0
		*p\jumpReload=0
		*p\parry=0
		*p\gravity=1
		*p\attacking=0
		*p\controlState\jump=0
		*p\controlState\keep=0
		*p\controlState\pushed=0
		*p\spawnedWind=#False
	EndIf
EndProcedure

Macro playerJumpReload(p)
	p\jumpReload=max(PLAYER_JUMP_RELOAD_BASE-playerGetspeed(p)*PLAYER_JUMP_RELOAD_PER_SPEED-playerGetAgility(p)*PLAYER_JUMP_RELOAD_PER_AGILITY+max(0,playerGetWeight(p)*PLAYER_JUMP_RELOAD_WEIGHT-playerGetStrength(p)*PLAYER_JUMP_RELOAD_STRENGTH)*PLAYER_JUMP_RELOAD_HINDRANCE_FACTOR,0)
EndMacro

; Global *emptyAnimation.animation=animationCreate(0,0,0,0,"empty")

Procedure playerGetAnimationType(*who.player)
	If *who And *who\currentAnimation
		ProcedureReturn *who\currentAnimation\animationType
	EndIf
	ProcedureReturn -1
EndProcedure

Macro isPlayerAnimationType(p,type)
	Bool(playerGetAnimationType(p)=type)
EndMacro

Macro clearPlayerFrames(p)
	classClearFrames(p\class)
EndMacro

Declare playerStickToGround(*p.player,*b.background)
Procedure playerResetAnimationTo(*who.player,*what.animation)
	If *who
		If Not *what
			Debug "no animation !"
			*what=playerGetIdle(*who)
		EndIf
;  		Debug *who\name+" reset animation to "+*what\name
; 		If *who\currentAnimation\id=*who\class\animations[#H2H_CLASS_ANIMATION_BACK]\id
; 			CallDebugger
; 		EndIf
		animationCopy(*who\currentAnimation,*what)
		animationInit(*who\currentAnimation)
		*who\currentFrame=*who\currentAnimation\frames(0)
		*who\spawnedWind=#False
		*who\spawnedProjectile=#False
		*who\frameIndicator=1
		*what\index=0
		*who\hasHitSomeone=0
		*who\yPerturbation=0
		*who\blocked=#False
; 		If isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_IDLE) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_JUMP) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_LAND) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_DEATH) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_SPAWN) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_FRONT) Or isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_BACK)
			*who\hasMoved=0
; 		EndIf
		
		If Not animationIsUngrounded(*who\currentAnimation) And *who\position\y>groundLevel And Not isPlayerAnimationType(*who,#H2H_ANIMATIONTYPE_JUMP)
			*who\position\y=groundLevel
		EndIf
; 		If *who\blocked<=0
		playerApplyMovement(*who)
; 		EndIf
	EndIf
EndProcedure

; Stick the player against one of the terrain border if outside
; Returns 1 if collision with left border
; Returns 2 if collision with right border
Procedure.i playerBorderCheck(*p.player,*b.background)
	If Not isPlayerAnimationType(*p,#H2H_ANIMATIONTYPE_SPAWN)
		If *p\lockedDirection
			If *p\position\x<-#HITBOX_BACKSHIFT_X+*b\leftLimit
				*p\position\x=-#HITBOX_BACKSHIFT_X+*b\leftLimit
				ProcedureReturn 1
			Else
				If *p\position\x>*b\rightLimit-(#HITBOX_BACKSHIFT_X+#HITBOX_SIZE)
					*p\position\x=*b\rightLimit-(#HITBOX_BACKSHIFT_X+#HITBOX_SIZE)
					ProcedureReturn 2
				EndIf
			EndIf
		Else
			If *p\position\x<-#HITBOX_SHIFT_X+*b\leftLimit
				*p\position\x=-#HITBOX_SHIFT_X+*b\leftLimit
				ProcedureReturn 1
			Else
				If *p\position\x>*b\rightLimit-(#HITBOX_SHIFT_X+#HITBOX_SIZE)
					*p\position\x=*b\rightLimit-(#HITBOX_SHIFT_X+#HITBOX_SIZE)
					ProcedureReturn 2
				EndIf
			EndIf
		EndIf
	EndIf
	ProcedureReturn 0
EndProcedure

Procedure playerGetPushPower(*pusher.player)
	Protected pusherForce=playerGetStrength(*pusher)*PLAYER_BULLDOZE_STRENGTH_FACTOR
	pusherForce+playerGetAgility(*pusher)*PLAYER_BULLDOZE_AGILITY_FACTOR
	pusherForce+playerGetSpeed(*pusher)*PLAYER_BULLDOZE_SPEED_FACTOR
	pusherForce+playerGetWeight(*pusher)*PLAYER_BULLDOZE_WEIGHT_FACTOR
	pusherForce+playerGetStamina(*pusher)*PLAYER_BULLDOZE_STAMINA_FACTOR
	; TODO detect landing animation
	If isPlayerAnimationType(*pusher,#H2H_ANIMATIONTYPE_BACK)
		pusherForce*PLAYER_BULLDOZE_BACKWARD_FACTOR
	EndIf
	
	If isPlayerAnimationType(*pusher,#H2H_ANIMATIONTYPE_FRONT)
		pusherForce*PLAYER_BULLDOZE_PUSH_FACTOR
	EndIf
	If playerGetStrength(*pusher)>playerGetWeight(*pusher)
		pusherForce+(playerGetStrength(*pusher)-playerGetWeight(*pusher))*PLAYER_BULLDOZE_DIFFERENCE_FACTOR
	EndIf
	ProcedureReturn pusherForce
EndProcedure

Procedure.d jumpPower(strength.i,speed.i,weight.i)
	Protected w.d=(strength-weight)*PLAYER_JUMP_WEIGHT_FACTOR ; 2
	If w>0
		w=0
	EndIf
	w=Abs(w)
	power.d=-PLAYER_JUMP_BASE+w ; 30
	k.d=PLAYER_JUMP_TEMPER_BASE ; 5
	speed-1
	For i=0 To speed
		power-k
		If power<-PLAYER_JUMP_BASE
			k-PLAYER_JUMP_TEMPER_DECREMENT
			If k<PLAYER_JUMP_TEMPER_THRESHOLD ; 1
				k=PLAYER_JUMP_TEMPER_THRESHOLD
			EndIf
		EndIf
	Next
	ProcedureReturn power
EndProcedure

